#!/usr/bin/env bash
# qa-hooktest — regression tests for the two PreToolUse hooks. Run from the toolkit repo:
#
#     qa-warden/bin/qa-hooktest
#
# NOT shipped to consumers. The hooks are the only deterministic code in this plugin that can
# BLOCK a write, and until this file they had no tests at all — each case below was first run
# by hand during the 2026-09-20 audit and is pinned here so the next edit to a regex cannot
# quietly turn a gate off (or turn it on for code that should pass).
#
# Every case is a real hook payload piped to the real script. `deny` means the hook printed a
# permissionDecision of "deny"; `allow` means it printed nothing. A hook never signals through
# its exit code (it fails OPEN, exit 0, by design), so the exit code is not what is asserted.
#
# KNOWN GAPS are asserted too, as `allow`, on purpose: hooks/README.md calls this layer a
# SUBSET gate with the reviewer as backstop, so these are documented limits, not bugs. Pinning
# them means that if someone closes one, this file says so instead of silently drifting.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HK="$here/hooks"
command -v jq >/dev/null || { echo "qa-hooktest: jq is required" >&2; exit 2; }

# A minimal QA project root, so the hooks' "is this path inside a QA project" test passes.
P=$(mktemp -d "${TMPDIR:-/tmp}/qa-hooktest-XXXXXX") || exit 2
trap 'rm -rf "$P"' EXIT
# hook_qa_root() keys on exactly two files: playwright.config.ts + scripts/prod-guard.ts.
mkdir -p "$P/tests/auth" "$P/page-objects" "$P/specs" "$P/src" "$P/scripts"
cp "$here/templates/playwright.config.ts" "$P/" || exit 2
cp "$here/templates/scripts/prod-guard.ts" "$P/scripts/" || exit 2
# macOS: mktemp returns /var/..., the hooks resolve it to /private/var/... — use the real path.
P=$(cd "$P" && pwd -P)

pass=0; bad=0
# run <hook> <expect: deny|allow> <label> <payload-json>
run() {
  local out got
  out=$(printf '%s' "$4" | CLAUDE_PROJECT_DIR="$P" CLAUDE_PLUGIN_ROOT="$here" bash "$HK/$1" 2>/dev/null)
  if printf '%s' "$out" | grep -q '"permissionDecision":"deny"'; then got=deny; else got=allow; fi
  if [ "$got" = "$2" ]; then pass=$((pass+1)); printf '  ok    %-5s %s\n' "$2" "$3"
  else bad=$((bad+1)); printf '  FAIL  expected %s, got %s — %s\n' "$2" "$got" "$3"; fi
}
write() { jq -nc --arg p "$P/$1" --arg c "$2" --arg d "$P" \
  '{hook_event_name:"PreToolUse",tool_name:"Write",cwd:$d,tool_input:{file_path:$p,content:$c}}'; }
edit()  { jq -nc --arg a "$1" --arg p "$P/$2" --arg o "$3" --arg n "$4" --arg d "$P" \
  '{hook_event_name:"PreToolUse",tool_name:"Edit",agent_type:$a,cwd:$d,tool_input:{file_path:$p,old_string:$o,new_string:$n}}'; }

echo "spec-lint.sh — the four lexical reviewer FAILs"
run spec-lint.sh deny  "Check 1: expect on a literal"        "$(write tests/a.spec.ts "test('x', async()=>{ expect(true).toBe(true); });")"
run spec-lint.sh deny  "Check 1: expect(1).toBe(1)"          "$(write tests/a.spec.ts "expect(1).toBe(1);")"
run spec-lint.sh deny  "Check 5: page.waitForTimeout"        "$(write tests/a.spec.ts "await page.waitForTimeout(500);")"
run spec-lint.sh deny  "Check 5: networkidle"                "$(write tests/a.spec.ts "await page.waitForLoadState('networkidle');")"
run spec-lint.sh deny  "Check 9: raw CSS locator"            "$(write tests/a.spec.ts "await page.locator('.btn-primary > span').click();")"
run spec-lint.sh deny  "Check 9: raw CSS in a page object"   "$(write page-objects/login.page.ts "this.btn = page.locator('#submit');")"
run spec-lint.sh deny  "Check 11: test.only"                 "$(write tests/a.spec.ts "test.only('x', async()=>{});")"
run spec-lint.sh deny  "Check 11: routeFromHAR"              "$(write tests/a.spec.ts "await page.routeFromHAR('a.har');")"
run spec-lint.sh allow "clean role locator + web-first expect" "$(write tests/a.spec.ts "await expect(page.getByRole('button',{name:'Save'})).toBeVisible();")"
run spec-lint.sh allow "expect timeout option is not a sleep" "$(write tests/a.spec.ts "await expect(page.getByRole('alert')).toBeVisible({ timeout: 10000 });")"
run spec-lint.sh allow "out of scope: product source"        "$(write src/app.ts "await page.waitForTimeout(500);")"
echo "spec-lint.sh — KNOWN GAPS (the reviewer is the backstop; see hooks/README.md)"
run spec-lint.sh allow "gap: call split across lines"        "$(write tests/a.spec.ts "await page
  .waitForTimeout(500);")"
run spec-lint.sh allow "gap: toBeTruthy on a literal"        "$(write tests/a.spec.ts "expect('ok').toBeTruthy();")"

echo "assertion-contract.sh — healer/verifier may not rewrite an assertion"
OLD="await expect(page.getByRole('alert')).toHaveText('Invalid credentials');"
run assertion-contract.sh deny  "healer retypes the expected string" "$(edit healer tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toHaveText('Incorrect email or password');")"
run assertion-contract.sh deny  "verifier swaps the matcher"         "$(edit verifier tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toContainText('Invalid credentials');")"
run assertion-contract.sh deny  "healer deletes the assertion"       "$(edit healer tests/auth/login.spec.ts "$OLD" "// removed")"
run assertion-contract.sh deny  "namespaced qa-warden:healer"        "$(edit qa-warden:healer tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toHaveText('Incorrect email or password');")"
run assertion-contract.sh deny  "namespaced qa-warden:verifier"      "$(edit qa-warden:verifier tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toContainText('Invalid credentials');")"
PROBE="  await page.route('**/api/login', r => r.fulfill({ status: 500 }));"
run assertion-contract.sh allow "verifier reverts an expect-free probe"          "$(edit verifier tests/auth/login.spec.ts "$PROBE" "")"
run assertion-contract.sh deny  "verifier probe that carries an expect is stuck (known limit)" "$(edit verifier tests/auth/login.spec.ts "$PROBE
  await expect(page.getByRole('alert')).toBeVisible();" "")"
run assertion-contract.sh allow "healer re-points the LOCATOR only"  "$(edit healer tests/auth/login.spec.ts "$OLD" "await expect(page.getByTestId('login-error')).toHaveText('Invalid credentials');")"
run assertion-contract.sh allow "generator is out of scope"          "$(edit generator tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toHaveText('Something else');")"
run assertion-contract.sh allow "no agent_type (main session/human)" "$(edit "" tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toHaveText('Something else');")"

echo "assertion-contract.sh — the oracle module (tests/<area>/<feature>.oracle.ts, F-33)"
ORA="export const EXPECTED_TOTAL = '\$52.00';"
run assertion-contract.sh deny  "healer retypes an expected total"       "$(edit healer tests/auth/login.oracle.ts "$ORA" "export const EXPECTED_TOTAL = '\$53.00';")"
run assertion-contract.sh deny  "verifier retypes an expected total"     "$(edit verifier tests/auth/login.oracle.ts "$ORA" "export const EXPECTED_TOTAL = '\$53.00';")"
run assertion-contract.sh deny  "healer deletes an oracle constant"      "$(edit healer tests/auth/login.oracle.ts "$ORA" "")"
run assertion-contract.sh deny  "healer edits a bare value fragment"     "$(edit healer tests/auth/login.oracle.ts "52.00" "53.00")"
printf '%s\n' "// pinned by the generator" "$ORA" > "$P/tests/auth/login.oracle.ts"
run assertion-contract.sh deny  "healer Write-overwrites the module"     "$(jq -nc --arg p "$P/tests/auth/login.oracle.ts" --arg d "$P" --arg c "export const EXPECTED_TOTAL = '\$53.00';" \
  '{hook_event_name:"PreToolUse",tool_name:"Write",agent_type:"healer",cwd:$d,tool_input:{file_path:$p,content:$c}}')"
run assertion-contract.sh allow "verifier adds an export a twin needs"   "$(edit verifier tests/auth/login.oracle.ts "$ORA" "$ORA
export const REFUSAL = 'Payment failed';")"
run assertion-contract.sh allow "healer changes only a comment"          "$(edit healer tests/auth/login.oracle.ts "// total for 2 seats
$ORA" "// total for two seats
$ORA")"
run assertion-contract.sh allow "generator is out of scope"              "$(edit generator tests/auth/login.oracle.ts "$ORA" "export const EXPECTED_TOTAL = '\$53.00';")"
run assertion-contract.sh allow "no agent_type (main session/human)"     "$(edit "" tests/auth/login.oracle.ts "$ORA" "export const EXPECTED_TOTAL = '\$53.00';")"
run assertion-contract.sh allow "other non-spec helper is out of scope"  "$(edit healer tests/auth/helpers.ts "$ORA" "export const EXPECTED_TOTAL = '\$53.00';")"

echo "assertion-contract.sh — matcher options are contract; only timeout is not (2026-09-30 review)"
S="tests/auth/login.spec.ts"
run assertion-contract.sh deny  "healer inverts toBeVisible via { visible: false }" "$(edit healer $S "await expect(p).toBeVisible();" "await expect(p).toBeVisible({ visible: false });")"
run assertion-contract.sh deny  "healer loosens maxDiffPixelRatio"         "$(edit healer $S "await expect(page).toHaveScreenshot('a.png', { maxDiffPixelRatio: 0.01 });" "await expect(page).toHaveScreenshot('a.png', { maxDiffPixelRatio: 0.9 });")"
run assertion-contract.sh deny  "healer adds { ignoreCase: true }"         "$(edit healer $S "await expect(p).toHaveText('Save');" "await expect(p).toHaveText('Save', { ignoreCase: true });")"
run assertion-contract.sh deny  "verifier renames a locator { name }"      "$(edit verifier $S "await expect(page.getByRole('button', { name: 'Save' })).toBeVisible();" "await expect(page.getByRole('button', { name: 'Delete' })).toBeVisible();")"
run assertion-contract.sh allow "healer adds a sole { timeout }"           "$(edit healer $S "await expect(p).toBeVisible();" "await expect(p).toBeVisible({ timeout: 10_000 });")"
run assertion-contract.sh allow "healer adds timeout beside other options" "$(edit healer $S "await expect(page).toHaveScreenshot('a.png', { maxDiffPixelRatio: 0.01 });" "await expect(page).toHaveScreenshot('a.png', { timeout: 15000, maxDiffPixelRatio: 0.01 });")"
run assertion-contract.sh allow "healer widens an existing timeout"        "$(edit healer $S "await expect(p).toBeVisible({ visible: false, timeout: 5000 });" "await expect(p).toBeVisible({ visible: false, timeout: 15000 });")"

echo "assertion-contract.sh — multi-line (Prettier-wrapped) assertions"
W1="await expect(page.getByRole('status')).toHaveText(
  'Order placed',
);"
run assertion-contract.sh deny  "healer retypes a wrapped expected string" "$(edit healer $S "$W1" "await expect(page.getByRole('status')).toHaveText(
  'Anything',
);")"
run assertion-contract.sh deny  "healer swaps a matcher on a chained line" "$(edit healer $S "await expect(page.getByRole('status'))
  .toHaveText('Order placed');" "await expect(page.getByRole('status'))
  .toContainText('Order');")"
run assertion-contract.sh allow "healer re-points a wrapped locator"       "$(edit healer $S "$W1" "await expect(page.getByTestId('order-status')).toHaveText(
  'Order placed',
);")"
run assertion-contract.sh allow "healer only re-wraps (Prettier reformat)" "$(edit healer $S "$W1" "await expect(page.getByRole('status')).toHaveText('Order placed');")"
run assertion-contract.sh allow "a quoted paren does not swallow the next assertion's heal" "$(edit healer $S "await expect(a).toHaveText('(1 item');
await expect(page.getByRole('x')).toHaveText('B');" "await expect(a).toHaveText('(1 item');
await expect(page.getByTestId('x')).toHaveText('B');")"

# A long test body must not become one giant "statement": the test(...) paren stays open for
# the whole body, and a joiner that followed it would chunk the file at arbitrary line counts,
# so a healer adding one line would shift every chunk and false-deny.
LONG="test('checkout', async ({ page }) => {"
for i in $(seq 1 40); do LONG="$LONG
  await page.getByRole('button', { name: 'Step $i' }).click();
  await expect(page.getByRole('heading')).toHaveText('Step $i');"; done
LONG="$LONG
});"
printf '%s\n' "$LONG" > "$P/tests/auth/long.spec.ts"
run assertion-contract.sh allow "healer Write adds one wait line to an 80-line test" "$(jq -nc --arg p "$P/tests/auth/long.spec.ts" --arg d "$P" --arg c "$(printf '%s\n' "$LONG" | sed '2i\
  await page.getByRole('"'"'main'"'"').waitFor();')" \
  '{hook_event_name:"PreToolUse",tool_name:"Write",agent_type:"healer",cwd:$d,tool_input:{file_path:$p,content:$c}}')"
run assertion-contract.sh deny  "healer Write retypes one value deep in an 80-line test" "$(jq -nc --arg p "$P/tests/auth/long.spec.ts" --arg d "$P" --arg c "$(printf '%s\n' "$LONG" | sed "s/toHaveText('Step 33')/toHaveText('Step 34')/")" \
  '{hook_event_name:"PreToolUse",tool_name:"Write",agent_type:"healer",cwd:$d,tool_input:{file_path:$p,content:$c}}')"

echo "assertion-contract.sh — the subset test is locale-independent"
A2="await expect(a).toHaveText('Bob');
await expect(b).toHaveText('alice');"
LC_ALL=en_US.UTF-8 run assertion-contract.sh allow "healer adds a barrier assert (en_US collation)" "$(edit healer $S "$A2" "$A2
await expect(c).toHaveText('Zoe');")"

echo "assertion-contract.sh — healer stubs and clocks, any receiver"
G="await page.goto('/');"
run assertion-contract.sh deny  "healer adds page.context().route"   "$(edit healer $S "$G" "await page.context().route('**/api', r => r.fulfill({ status: 200 }));
$G")"
run assertion-contract.sh deny  "healer adds page.routeWebSocket"    "$(edit healer $S "$G" "await page.routeWebSocket('ws://x', ws => {});
$G")"
run assertion-contract.sh deny  "healer adds context.routeFromHAR"   "$(edit healer $S "$G" "await context.routeFromHAR('a.har');
$G")"
run assertion-contract.sh deny  "healer adds context.clock"          "$(edit healer $S "$G" "await context.clock.runFor(2000);
$G")"
run assertion-contract.sh deny  "healer adds browserContext.route"   "$(edit healer $S "$G" "await browserContext.route('**/api', r => r.abort());
$G")"

echo "hook_qa_root — a QA project nested under a directory named tests/"
N="$P/mono/tests/qa"
mkdir -p "$N/tests/auth" "$N/scripts"
cp "$here/templates/playwright.config.ts" "$N/" && cp "$here/templates/scripts/prod-guard.ts" "$N/scripts/"
run spec-lint.sh deny "nested project: waitForTimeout" "$(write mono/tests/qa/tests/a.spec.ts "await page.waitForTimeout(500);")"
run assertion-contract.sh deny "nested project: healer retype" "$(edit healer mono/tests/qa/tests/auth/login.spec.ts "$OLD" "await expect(page.getByRole('alert')).toHaveText('Nope');")"
run spec-lint.sh allow "nested project: non-test dir stays out of scope" "$(write mono/tests/qa/src/a.ts "await page.waitForTimeout(500);")"

echo "escape hatch"
out=$(printf '%s' "$(write tests/a.spec.ts "await page.waitForTimeout(500);")" | QA_HOOKS_OFF=1 CLAUDE_PROJECT_DIR="$P" bash "$HK/spec-lint.sh" 2>/dev/null)
if [ -z "$out" ]; then pass=$((pass+1)); echo "  ok    allow QA_HOOKS_OFF=1 disables the layer"; else bad=$((bad+1)); echo "  FAIL  QA_HOOKS_OFF=1 did not disable spec-lint"; fi

echo "---"
if [ "$bad" -ne 0 ]; then echo "qa-hooktest: ❌ $bad of $((pass+bad)) cases FAILED"; exit 1; fi
echo "qa-hooktest: ✅ all $pass cases passed"
