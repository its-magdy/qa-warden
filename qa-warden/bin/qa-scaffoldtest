check_eq "launcher passes the doctor's exit code through" "$DR_RC" "$LN_RC"
check "launcher names the plugin it runs" grep -qF "recorded plugin install → $here" <<<"$LN_OUT"
check_same "launcher output is the doctor's, after its one notice line" "$fresh_out" "$(tail -n +2 <<<"$LN_OUT")"
# The 0 == 0 case above cannot tell a pass-through from a launcher that always exits 0. Make the
# doctor FAIL (a toolkit-owned file missing is a ❌) and require the same non-zero code.
mv "$D/playwright.config.ts" "$D/playwright.config.ts.away"
