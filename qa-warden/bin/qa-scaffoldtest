#!/usr/bin/env bash
# qa-scaffoldtest — regression tests for bin/qa-scaffold and templates/scripts/prod-guard.sh.
# Run from the toolkit repo:
#
#     qa-warden/bin/qa-scaffoldtest
#
# NOT shipped to consumers. Until this file, the only thing that ran qa-scaffold was an eval
# fixture (evals/_lib/base-project.sh) that needs `claude plugin eval`, so the settings.json
# merge, the --resync backups and the .gitignore carve-out its comments describe were asserted
# nowhere. Every case stamps into its own mktemp directory, so nothing here touches a real
# project. No network, no npm install (--no-install), no model calls.
#
# What is pinned:
#   1. fresh stamp     the file set is DERIVED from templates/ + manifests/resync-set.txt (not a hand
#                      list that drifts), a second stamp changes nothing, and the plugin-only
#                      manifests (manifests/*.txt) never reach a project
#   2. settings merge  union of the allow/deny rules, the project's own rules and sibling keys
#                      (model, ask, defaultMode, env, its own marketplace entry) survive, no
#                      duplicates, and a re-run is byte-stable
#   3. --resync        toolkit-owned files restored with a .qa-bak, `*.qa-bak` gitignored exactly
#                      once, CLAUDE.md / .env / .gitignore never overwritten, rules re-merged
#   4. doctor          the plugin's skills/doctor/scripts/doctor.sh finds its baseline beside
#                      itself (no drift on a fresh stamp, real drift reported, CLAUDE_PLUGIN_ROOT
#                      ignored), and the stamped scripts/doctor.sh launcher runs it from the
#                      recorded install, or exits 2 without guessing; the spec format's move from
#                      CLAUDE.md into the test-case-contract skill (old section warned, a missing
#                      pointer nudged, Check 2 compares key sets with the skill exactly,
#                      fault:/clock: no longer demanded in CLAUDE.md)
#   5. prod-guard.sh   the URL table: staging passes, a word-boundary prod marker refuses,
#                      QA_ALLOW_PROD=1 lifts the marker refusal ONLY, placeholders never pass
#
# The prod-guard.ts twin is not tested here: qa-hooktest only copies it as a project marker, and
# running it needs node + Playwright's dependencies, which this test deliberately does not install.
#
# Not asserted, on purpose: the `\@`, `https:/` and `%70` host-parsing quirks. prod-guard.sh
# documents them as correctness-only, not a security boundary.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
TEMPLATES="$here/templates"
SCAFFOLD="$here/bin/qa-scaffold"
PROD_GUARD="$TEMPLATES/scripts/prod-guard.sh"
# The resync set is plugin-only data: it lives in manifests/, outside templates/, so it is never
# stamped (qa-scaffold copies everything under templates/).
MANIFEST="$here/manifests/resync-set.txt"
# `jq -n` and not just `command -v`: a jq of the wrong CPU architecture is found but cannot run, and
# qa-scaffold would then quietly take its "could not auto-merge" path and fail every merge case.
jq -n 1 >/dev/null 2>&1 || { echo "qa-scaffoldtest: a working jq is required" >&2; exit 2; }
command -v git >/dev/null || { echo "qa-scaffoldtest: git is required (qa-scaffold git-inits the target)" >&2; exit 2; }
for f in "$SCAFFOLD" "$PROD_GUARD" "$MANIFEST" "$TEMPLATES/settings.json"; do
  [ -f "$f" ] || { echo "qa-scaffoldtest: missing $f" >&2; exit 2; }
done

# A developer's global git config (core.excludesFile, say) could already ignore `*.qa-bak` and
# hide the append path under test. Make git read nothing but the repo.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1

# Every case gets its own scratch directory; the trap removes them all, pass or fail.
SCRATCH=()
trap 'for d in "${SCRATCH[@]}"; do rm -rf "$d"; done' EXIT
# new_dir — creates a scratch directory and returns its path in $DIR. Not command-substituted
# on purpose: that would run in a subshell and the trap would never learn about the directory.
new_dir() {
  DIR=$(mktemp -d "${TMPDIR:-/tmp}/qa-scaffoldtest-XXXXXX") || exit 2
  # macOS: mktemp returns /var/..., git resolves it to /private/var/... — use the real path.
  DIR=$(cd "$DIR" && pwd -P)
  SCRATCH+=("$DIR")
}

pass=0; bad=0
# check <label> <command...> — passes when the command exits 0. Output is discarded.
check() {
  local label=$1; shift
  if "$@" >/dev/null 2>&1; then
    pass=$((pass+1)); printf '  ok    %s\n' "$label"
  else
    bad=$((bad+1)); printf '  FAIL  %s\n' "$label"
  fi
}
# check_eq <label> <expected> <actual>
check_eq() {
  if [ "$2" = "$3" ]; then
    pass=$((pass+1)); printf '  ok    %s\n' "$1"
  else
    bad=$((bad+1)); printf '  FAIL  %s (expected "%s", got "%s")\n' "$1" "$2" "$3"
  fi
}

# check_nonzero <label> <count> — a vacuity guard: a loop over an empty list passes by checking
# nothing, so each derived list is asserted non-empty before it is trusted.
check_nonzero() {
  if [ "${2:-0}" -gt 0 ] 2>/dev/null; then
    pass=$((pass+1)); printf '  ok    %s (%s)\n' "$1" "$2"
  else
    bad=$((bad+1)); printf '  FAIL  %s (got "%s")\n' "$1" "${2:-}"
  fi
}

# check_same <label> <snapshot-before> <snapshot-after> — like check_eq, but a failure names the
# paths that differ instead of dumping both snapshots.
check_same() {
  if [ "$2" = "$3" ]; then
    pass=$((pass+1)); printf '  ok    %s\n' "$1"
  else
    bad=$((bad+1)); printf '  FAIL  %s\n' "$1"
    diff <(printf '%s\n' "$2") <(printf '%s\n' "$3") | grep '^[<>]' | head -6 | sed 's/^/          /'
  fi
}

# stamp <dir> [extra qa-scaffold args...] — runs qa-scaffold with --no-install; output lands in
# $OUT, exit status in $RC. Run under the same bash that runs this test (3.2 on a stock Mac).
stamp() {
  local dir=$1; shift
  OUT=$("$BASH" "$SCAFFOLD" "$dir" --no-install "$@" 2>&1)
  RC=$?
}

# snapshot <dir> — one line per path, with a content checksum for files, .git excluded. Two equal
# snapshots mean no file was added, removed or changed.
snapshot() {
  (
    cd "$1" || exit 1
    find . -path ./.git -prune -o -print | sort | while IFS= read -r p; do
      if [ -f "$p" ]; then printf '%s ' "$(cksum < "$p")"; fi
      printf '%s\n' "$p"
    done
  )
}

# is_prefix <short> <long> — succeeds when <long> begins with every byte of <short>. Not `cmp -n`:
# BSD cmp (macOS) reports EOF on the shorter file even when the limit is within it.
is_prefix() {
  [ "$(head -c "$(wc -c < "$1")" "$2" | cksum)" = "$(cksum < "$1")" ]
}

# manifest_files — the toolkit-owned set, parsed the way qa-scaffold parses it, minus any entry
# with no template behind it (qa-scaffold skips those too).
manifest_files() {
  sed -e 's/#.*$//' -e 's/[[:space:]]*$//' "$MANIFEST" | grep -v '^$' | while IFS= read -r rel; do
    if [ -f "$TEMPLATES/$rel" ]; then printf '%s\n' "$rel"; fi
  done
}

# expected_files — every project-relative file a fresh stamp must leave behind, derived from
# templates/ with qa-scaffold's own two exceptions: `gitignore` lands as `.gitignore`, and
# settings.json is merged into .claude/ rather than copied. .env comes from .env.example.
expected_files() {
  (cd "$TEMPLATES" && find . -type f ! -name settings.json ! -name '.DS_Store' | sed 's|^\./||') \
    | sed 's|^gitignore$|.gitignore|'
  echo ".claude/settings.json"
  echo ".env"
}

# ------------------------------------------------------------------------------------------
echo "qa-scaffold — fresh stamp"
new_dir; D=$DIR
stamp "$D"
check_eq "stamp exits 0" "0" "$RC"
check_nonzero "first stamp reports files created" "$(printf '%s\n' "$OUT" | grep -c '\[qa-scaffold\] created')"
check_nonzero "derived expected file list is non-empty" "$(expected_files | grep -c .)"
missing=""
while IFS= read -r rel; do
  if [ ! -f "$D/$rel" ]; then missing="$missing $rel"; fi
done < <(expected_files)
check_eq "every derived template file exists" "" "$missing"
# The plugin-only manifests are read from the plugin by qa-scaffold, doctor and qa-selfcheck, never
# from a project. Assert both halves: no copy is stamped (under scripts/, where they used to land,
# or under their own name anywhere), and the resync set does not list one, which would make
# --resync and doctor's drift check expect a file the stamp never writes.
plugin_only=$(cd "$here/manifests" && find . -type f -name '*.txt' | sed 's|^\./||')
check_nonzero "manifests/ holds plugin-only manifests" "$(printf '%s\n' "$plugin_only" | grep -c .)"
stamped_po=""; listed_po=""
for m in $plugin_only; do
  if [ -n "$(find "$D" -path "$D/.git" -prune -o -name "$m" -print)" ]; then stamped_po="$stamped_po $m"; fi
  # Any non-comment line naming it, wherever the entry points (manifest_files would hide a
  # dangling entry, because it drops lines with no template behind them).
  if sed -e 's/#.*$//' "$MANIFEST" | grep -qF -e "$m"; then listed_po="$listed_po $m"; fi
done
check_eq "no plugin-only manifest is stamped into the project" "" "$stamped_po"
check_eq "resync-set.txt lists no plugin-only manifest" "" "$listed_po"
RUNTIME_DIRS=$(sed -e 's/#.*$//' -e 's/[[:space:]]*$//' "$TEMPLATES/scripts/runtime-dirs.txt" | grep -v '^$')
check_nonzero "runtime-dirs.txt lists directories" "$(printf '%s\n' "$RUNTIME_DIRS" | grep -c .)"
missing=""
for d in $RUNTIME_DIRS; do
  if [ ! -d "$D/$d" ]; then missing="$missing $d"; fi
done
check_eq "every runtime dir exists" "" "$missing"
check "scripts/*.sh are executable" test -x "$D/scripts/prod-guard.sh" -a -x "$D/scripts/doctor.sh"
check "target was git-initialised" test -d "$D/.git"
check "fresh .claude/settings.json is valid JSON" jq empty "$D/.claude/settings.json"
check "fresh settings.json carries every template allow rule" \
  jq -e -s '(.[1].permissions.allow - .[0].permissions.allow) == [] and (.[1].permissions.allow | length) > 0' \
    "$D/.claude/settings.json" "$TEMPLATES/settings.json"
check "fresh settings.json carries every template deny rule" \
  jq -e -s '(.[1].permissions.deny - .[0].permissions.deny) == [] and (.[1].permissions.deny | length) > 0' \
    "$D/.claude/settings.json" "$TEMPLATES/settings.json"
check "fresh settings.json allow/deny have no duplicates" \
  jq -e '(.permissions.allow | length) == (.permissions.allow | unique | length) and (.permissions.deny | length) == (.permissions.deny | unique | length)' \
    "$D/.claude/settings.json"
check "no settings.qa-suggested.json left behind" test ! -e "$D/.claude/settings.qa-suggested.json"
before=$(snapshot "$D")
stamp "$D"
after=$(snapshot "$D")
check_eq "second stamp exits 0" "0" "$RC"
check_same "second stamp is byte-identical (no file added, removed or changed)" "$before" "$after"
created=$(printf '%s\n' "$OUT" | grep -c '\[qa-scaffold\] created')
check_eq "second stamp reports nothing created" "0" "$created"

# ------------------------------------------------------------------------------------------
echo "qa-scaffold — settings.json merge into a project that already has one"
new_dir; D=$DIR
mkdir -p "$D/.claude"
# One custom allow, one custom deny, an `ask` list, defaultMode, a model, an env block, the
# project's own qa-warden marketplace entry (a fork), a second marketplace, and one rule the
# template also ships (to prove the union does not duplicate it).
cat > "$D/.claude/settings.json" <<'JSON'
{
  "model": "opus",
  "env": { "FOO": "bar" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash(make test)", "Read(./docs/**)", "Bash(jq *)"],
    "deny": ["Bash(shutdown *)"],
    "ask": ["Bash(git push*)"]
  },
  "extraKnownMarketplaces": {
    "qa-warden": { "source": { "source": "github", "repo": "someone/qa-warden-fork" } },
    "internal": { "source": { "source": "github", "repo": "acme/plugins" } }
  }
}
JSON
S="$D/.claude/settings.json"
new_dir; SEED=$DIR/seed.json
cp "$S" "$SEED"
stamp "$D"
check_eq "stamp exits 0" "0" "$RC"
check "result is valid JSON" jq empty "$S"
check "project allow rules survive" jq -e '.permissions.allow | index("Bash(make test)") and index("Read(./docs/**)")' "$S"
check "project deny rule survives" jq -e '.permissions.deny | index("Bash(shutdown *)")' "$S"
check "template allow rules are all present" \
  jq -e -s '(.[1].permissions.allow - .[0].permissions.allow) == []' "$S" "$TEMPLATES/settings.json"
check "template deny rules are all present" \
  jq -e -s '(.[1].permissions.deny - .[0].permissions.deny) == []' "$S" "$TEMPLATES/settings.json"
check "allow has no duplicates (shared rule appears once)" \
  jq -e '(.permissions.allow | length) == (.permissions.allow | unique | length)' "$S"
check "deny has no duplicates" jq -e '(.permissions.deny | length) == (.permissions.deny | unique | length)' "$S"
check "allow is exactly the union (nothing invented, nothing dropped)" \
  jq -e -s '.[0].permissions.allow == ((.[1].permissions.allow + .[2].permissions.allow) | unique)' \
    "$S" "$SEED" "$TEMPLATES/settings.json"
check "deny is exactly the union" \
  jq -e -s '.[0].permissions.deny == ((.[1].permissions.deny + .[2].permissions.deny) | unique)' \
    "$S" "$SEED" "$TEMPLATES/settings.json"
check "sibling key permissions.ask preserved" jq -e '.permissions.ask == ["Bash(git push*)"]' "$S"
check "sibling key permissions.defaultMode preserved" jq -e '.permissions.defaultMode == "acceptEdits"' "$S"
check "sibling key model preserved" jq -e '.model == "opus"' "$S"
check "sibling key env preserved" jq -e '.env == {"FOO": "bar"}' "$S"
check "project's own qa-warden marketplace entry wins over the template's" \
  jq -e '.extraKnownMarketplaces["qa-warden"].source.repo == "someone/qa-warden-fork"' "$S"
check "project's other marketplace entry preserved" \
  jq -e '.extraKnownMarketplaces.internal.source.repo == "acme/plugins"' "$S"
before=$(snapshot "$D")
stamp "$D"
after=$(snapshot "$D")
check_eq "re-run exits 0" "0" "$RC"
check_same "re-run is byte-stable (merging its own output changes nothing)" "$before" "$after"

# A project with settings.json and none of the template's keys still gets the template's
# marketplace entry, appended beneath its own keys.
new_dir; D=$DIR
mkdir -p "$D/.claude"
echo '{ "model": "sonnet" }' > "$D/.claude/settings.json"
stamp "$D"
check "bare project gets the template marketplace entry" \
  jq -e '.extraKnownMarketplaces["qa-warden"].source.repo == "its-magdy/qa-warden" and .model == "sonnet"' "$D/.claude/settings.json"

# ------------------------------------------------------------------------------------------
echo "qa-scaffold --resync — restore toolkit-owned files, never user-owned ones"
new_dir; D=$DIR
stamp "$D"
# Simulate a project scaffolded before the `*.qa-bak` rule shipped: drop it from .gitignore.
grep -v 'qa-bak' "$D/.gitignore" > "$D/.gitignore.tmp" && mv "$D/.gitignore.tmp" "$D/.gitignore"
check "precondition: .gitignore no longer mentions qa-bak" test "$(grep -c 'qa-bak' "$D/.gitignore")" = "0"
# Edit EVERY toolkit-owned file, plus the three user-owned ones that must survive.
owned=$(manifest_files)
check_nonzero "resync-set.txt resolves to template files" "$(printf '%s\n' "$owned" | grep -c .)"
for rel in $owned; do printf '\n# local edit\n' >> "$D/$rel"; done
printf '\n# my project policy\n' >> "$D/CLAUDE.md"
printf 'QA_USER_EMAIL=me@staging.dev\n' >> "$D/.env"
printf '\n# my own ignore rule\nlocal-notes/\n' >> "$D/.gitignore"
claude_before=$(cksum < "$D/CLAUDE.md"); env_before=$(cksum < "$D/.env")
new_dir; GI_BEFORE=$DIR/gitignore.before
cp "$D/.gitignore" "$GI_BEFORE"
# Knock one template rule out of settings.json: resync must merge it back.
jq '.permissions.allow -= ["Bash(rg *)"]' "$D/.claude/settings.json" > "$D/s.tmp" && mv "$D/s.tmp" "$D/.claude/settings.json"
check "precondition: settings.json lost a template rule" jq -e '.permissions.allow | index("Bash(rg *)") | not' "$D/.claude/settings.json"

stamp "$D" --resync
check_eq "resync exits 0" "0" "$RC"
stale=""; nobak=""
for rel in $owned; do
  if ! cmp -s "$TEMPLATES/$rel" "$D/$rel"; then stale="$stale $rel"; fi
  if ! grep -q 'local edit' "$D/$rel.qa-bak" 2>/dev/null; then nobak="$nobak $rel"; fi
done
check_eq "every edited toolkit-owned file is restored" "" "$stale"
check_eq "every restored file left a .qa-bak holding the edit" "" "$nobak"
check_eq "CLAUDE.md untouched" "$claude_before" "$(cksum < "$D/CLAUDE.md")"
check_eq ".env untouched" "$env_before" "$(cksum < "$D/.env")"
check ".gitignore keeps every byte the user had (the rule is only appended)" is_prefix "$GI_BEFORE" "$D/.gitignore"
check "no .qa-bak for CLAUDE.md / .env / .gitignore / settings.json" \
  test ! -e "$D/CLAUDE.md.qa-bak" -a ! -e "$D/.env.qa-bak" -a ! -e "$D/.gitignore.qa-bak" -a ! -e "$D/.claude/settings.json.qa-bak"
check_eq "*.qa-bak appended to .gitignore exactly once" "1" "$(grep -c '^\*\.qa-bak$' "$D/.gitignore")"
check "git agrees the backups are ignored" git -C "$D" check-ignore -q "playwright.config.ts.qa-bak"
check "rule knocked out of settings.json is merged back by resync" \
  jq -e '.permissions.allow | index("Bash(rg *)")' "$D/.claude/settings.json"
refreshed=$(printf '%s\n' "$OUT" | grep -c 'resynced')
check_eq "resync reports one resynced line per owned file" "$(printf '%s\n' "$owned" | grep -c .)" "$refreshed"

before=$(snapshot "$D")
stamp "$D" --resync
after=$(snapshot "$D")
check_eq "second resync exits 0" "0" "$RC"
check_same "second resync changes nothing" "$before" "$after"
check_eq "second resync does not append *.qa-bak again" "1" "$(grep -c '^\*\.qa-bak$' "$D/.gitignore")"
check "second resync says there was nothing to do" grep -q '0 file(s) refreshed' <<<"$OUT"

# A project whose .gitignore already ignores *.qa-bak (the shipped template does) is left alone.
new_dir; D=$DIR
stamp "$D"
printf '\n# local edit\n' >> "$D/playwright.config.ts"
stamp "$D" --resync
check_eq "template .gitignore keeps its single *.qa-bak rule through a resync" "1" "$(grep -c '^\*\.qa-bak$' "$D/.gitignore")"

# ------------------------------------------------------------------------------------------
echo "doctor — runs from the plugin; the stamped scripts/doctor.sh only launches it"
# run_doctor <dir> [VAR=value ...] — the plugin's doctor, run from <dir> the way the skill runs it.
# CLAUDE_PROJECT_DIR is dropped so the doctor reads <dir>/.env, not the caller's project.
run_doctor() {
  local dir=$1; shift
  DR_OUT=$(cd "$dir" && env -u CLAUDE_PROJECT_DIR -u CLAUDE_PLUGIN_ROOT "$@" "$BASH" "$DOCTOR" 2>&1)
  DR_RC=$?
}
# run_launcher <dir> <config-dir> [VAR=value ...] — the stamped launcher, with a fake
# CLAUDE_CONFIG_DIR so the install record it reads is the one this test wrote.
run_launcher() {
  local dir=$1 cfg=$2; shift 2
  LN_OUT=$(cd "$dir" && env -u CLAUDE_PROJECT_DIR -u CLAUDE_PLUGIN_ROOT CLAUDE_CONFIG_DIR="$cfg" "$@" \
             "$BASH" scripts/doctor.sh 2>&1)
  LN_RC=$?
}
# record <config-dir> <json-array-of-installs> — writes plugins/installed_plugins.json.
record() {
  mkdir -p "$1/plugins"
  printf '{ "version": 2, "plugins": { "qa-warden@qa-warden": %s } }\n' "$2" > "$1/plugins/installed_plugins.json"
}
DOCTOR="$here/skills/doctor/scripts/doctor.sh"
check "the doctor ships in the plugin at skills/doctor/scripts/doctor.sh" test -f "$DOCTOR"
new_dir; D=$DIR
stamp "$D"
run_doctor "$D"
check_eq "doctor on a fresh stamp exits 0 (warnings only)" "0" "$DR_RC"
check "doctor prints its rollup line" grep -q '^doctor: ' <<<"$DR_OUT"
check "doctor finds its baseline beside itself (no drift-check SKIPPED)" test "$(grep -c 'SKIPPED' <<<"$DR_OUT")" = "0"
check "a fresh stamp shows no substrate drift or missing file" \
  test "$(grep -c -e 'substrate drift' -e 'substrate missing' <<<"$DR_OUT")" = "0"
fresh_out=$DR_OUT
run_doctor "$D" CLAUDE_PLUGIN_ROOT=/nonexistent
check_same "doctor ignores CLAUDE_PLUGIN_ROOT (output identical)" "$fresh_out" "$DR_OUT"
# The vacuity guard for the "no drift" case: a real edit must be reported.
printf '\n# local edit\n' >> "$D/scripts/prod-guard.sh"
run_doctor "$D"
check "an edited toolkit-owned file is reported as drift" grep -q 'substrate drift: scripts/prod-guard.sh' <<<"$DR_OUT"
cp "$TEMPLATES/scripts/prod-guard.sh" "$D/scripts/prod-guard.sh"

new_dir; CFG=$DIR
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$here\", \"lastUpdated\": \"2026-10-01T00:00:00Z\"}]"
run_launcher "$D" "$CFG"
check_eq "launcher passes the doctor's exit code through" "$DR_RC" "$LN_RC"
check "launcher names the plugin it runs" grep -qF "recorded plugin install → $here" <<<"$LN_OUT"
check_same "launcher output is the doctor's, after its one notice line" "$fresh_out" "$(tail -n +2 <<<"$LN_OUT")"
# The 0 == 0 case above cannot tell a pass-through from a launcher that always exits 0. Make the
# doctor FAIL (a toolkit-owned file missing is a ❌) and require the same non-zero code.
mv "$D/playwright.config.ts" "$D/playwright.config.ts.away"
run_doctor "$D"
check_eq "precondition: doctor exits 1 with playwright.config.ts missing" "1" "$DR_RC"
run_launcher "$D" "$CFG"
check_eq "launcher passes a failing doctor's exit code through (1)" "1" "$LN_RC"
mv "$D/playwright.config.ts.away" "$D/playwright.config.ts"
# A project-scope record for THIS directory outranks a user-scope one.
new_dir; NODOC=$DIR   # a "plugin" with no doctor in it
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$NODOC\", \"lastUpdated\": \"2026-10-09T00:00:00Z\"},
                {\"scope\": \"project\", \"projectPath\": \"$D\", \"installPath\": \"$here\", \"lastUpdated\": \"2026-10-01T00:00:00Z\"}]"
run_launcher "$D" "$CFG"
check "launcher prefers this project's install over the user-scope one" grep -qF "recorded plugin install → $here" <<<"$LN_OUT"
# Within one tier the newest record wins, not the first in the file: the stale one comes first here.
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$NODOC\", \"lastUpdated\": \"2026-09-01T00:00:00Z\"},
                {\"scope\": \"user\", \"installPath\": \"$here\", \"lastUpdated\": \"2026-10-09T00:00:00Z\"}]"
run_launcher "$D" "$CFG"
check "launcher picks the newest record within a scope, not the first" grep -qF "recorded plugin install → $here" <<<"$LN_OUT"
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$NODOC\", \"lastUpdated\": \"2026-10-09T00:00:00Z\"}]"
run_launcher "$D" "$CFG"
check_eq "launcher exits 2 when the recorded plugin has no doctor" "2" "$LN_RC"
check "  and says the plugin is older than the launcher" grep -qF "older than this launcher" <<<"$LN_OUT"
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$NODOC/gone\", \"lastUpdated\": \"2026-10-09T00:00:00Z\"}]"
run_launcher "$D" "$CFG"
check_eq "launcher exits 2 when the recorded install path is gone" "2" "$LN_RC"
check "  and says the record is stale, not that the plugin is old" grep -qF "no longer exists" <<<"$LN_OUT"
printf '{ not json\n' > "$CFG/plugins/installed_plugins.json"
run_launcher "$D" "$CFG"
check_eq "launcher exits 2 on a malformed install record" "2" "$LN_RC"
check "  and says jq failed to read it" grep -qF "jq failed to read" <<<"$LN_OUT"
# A jq that is found but cannot run (this is what an x86-only jq does on Apple silicon).
new_dir; FAKEJQ=$DIR
printf '#!/bin/sh\necho "fake jq cannot execute" >&2\nexit 126\n' > "$FAKEJQ/jq"
chmod +x "$FAKEJQ/jq"
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$here\", \"lastUpdated\": \"2026-10-09T00:00:00Z\"}]"
run_launcher "$D" "$CFG" PATH="$FAKEJQ:$PATH"
check_eq "launcher exits 2 when jq cannot run" "2" "$LN_RC"
check "  and shows jq's own error" grep -qF "fake jq cannot execute" <<<"$LN_OUT"
new_dir; EMPTYCFG=$DIR
run_launcher "$D" "$EMPTYCFG"
check_eq "launcher exits 2 with no install record (no guessing)" "2" "$LN_RC"
check "  and runs nothing" test "$(grep -c '^doctor: ' <<<"$LN_OUT")" = "0"
run_launcher "$D" "$EMPTYCFG" CLAUDE_PLUGIN_ROOT="$here"
check_eq "launcher ignores CLAUDE_PLUGIN_ROOT (still exits 2)" "2" "$LN_RC"

echo "  -- the spec format lives in the test-case-contract skill, not in CLAUDE.md"
OLDSEC="still has the '## Test case format contract' section"
check "a fresh CLAUDE.md has no '## Test case format contract' section" \
  test "$(grep -c '^## Test case format contract' "$D/CLAUDE.md")" = "0"
check "a fresh stamp gets no old-section warning" test "$(grep -cF "$OLDSEC" <<<"$fresh_out")" = "0"
check "a fresh stamp gets no oracle-key finding (Check 2 reads the skill, not CLAUDE.md)" \
  test "$(grep -c "oracle key '" <<<"$fresh_out")" = "0"
# A project stamped before the move keeps the section, because CLAUDE.md is never resynced.
new_dir; OLDP=$DIR
stamp "$OLDP"
printf '\n## Test case format contract\n\nSpecs are Markdown prose plus fenced YAML blocks.\n' >> "$OLDP/CLAUDE.md"
printf '\n### Situation steps — `fault:` (network) and `clock:` (time)\n' >> "$OLDP/CLAUDE.md"
run_doctor "$OLDP"
check "a CLAUDE.md that still has the old section is warned" grep -qF "$OLDSEC" <<<"$DR_OUT"
check_eq "  as a warning, so doctor still exits 0" "0" "$DR_RC"
# Everything else matches a fresh stamp: the only new line besides the rollup is that warning.
newlines=$(diff <(printf '%s\n' "$fresh_out") <(printf '%s\n' "$DR_OUT") | grep '^>' | grep -v '^> doctor: ')
check_eq "  and it is the only new finding" "1" "$(printf '%s\n' "$newlines" | grep -c .)"
check "  that one line is the old-section warning" grep -qF "$OLDSEC" <<<"$newlines"
# Negative control: the heading is matched as a level-2 heading on its own line, not as text.
new_dir; MENTP=$DIR
stamp "$MENTP"
printf '\nOur notes on the old "Test case format contract" are in the wiki.\n' >> "$MENTP/CLAUDE.md"
printf '\n### Test case format contract\n\n## Test case format contract notes\n' >> "$MENTP/CLAUDE.md"
run_doctor "$MENTP"
check "a prose mention, a ### heading or a longer ## heading is not warned" \
  test "$(grep -cF "$OLDSEC" <<<"$DR_OUT")" = "0"
# With the section and the template's pointer both gone, CLAUDE.md has no `fault:`/`clock:` at
# all. The vocabulary-containment check must not ask for them back: they ship in the skill now.
grep -v -e 'fault:' -e 'clock:' "$MENTP/CLAUDE.md" > "$MENTP/CLAUDE.md.new"
mv "$MENTP/CLAUDE.md.new" "$MENTP/CLAUDE.md"
check "precondition: CLAUDE.md now mentions neither fault: nor clock:" \
  test "$(grep -c -e 'fault:' -e 'clock:' "$MENTP/CLAUDE.md")" = "0"
run_doctor "$MENTP"
check "a CLAUDE.md without fault:/clock: is not asked to restore them" \
  test "$(grep -c -e 'never mentions `fault:`' -e 'never mentions `clock:`' <<<"$DR_OUT")" = "0"
# A CLAUDE.md whose old section was deleted without putting the template's pointer back: the
# vocabulary-containment check nudges the pointer in, and that is the only new finding.
new_dir; LEGP=$DIR
stamp "$LEGP"
awk '/^## Spec format$/{skip=1; next} skip && /^## /{skip=0} !skip' "$LEGP/CLAUDE.md" \
  | sed 's/Closed vocabulary\*\* — the `test-case-contract` skill;/Closed vocabulary** — see above;/' > "$LEGP/CLAUDE.md.new"
mv "$LEGP/CLAUDE.md.new" "$LEGP/CLAUDE.md"
check "precondition: CLAUDE.md now never names test-case-contract" \
  test "$(grep -c 'test-case-contract' "$LEGP/CLAUDE.md")" = "0"
run_doctor "$LEGP"
newlines=$(diff <(printf '%s\n' "$fresh_out") <(printf '%s\n' "$DR_OUT") | grep '^>' | grep -v '^> doctor: ')
check "a CLAUDE.md without the pointer is asked to restore it" grep -qF 'never mentions `test-case-contract`' <<<"$newlines"
check_eq "  and that is the only new finding" "1" "$(printf '%s\n' "$newlines" | grep -c .)"
# Check 2 compares key SETS exactly. A key the skill does not define FAILs, including the words
# that occur in the skill's prose (`value`, `lock`), which a substring scan used to let through.
for bogus in not_a_real_key value lock; do
  new_dir; VKP=$DIR
  stamp "$VKP"
  printf '%s\n' "$bogus" >> "$VKP/scripts/oracle-keys.txt"
  run_doctor "$VKP"
  check "Check 2 fails the manifest key '$bogus', which the skill does not define" grep -qF "oracle key '$bogus' (scripts/oracle-keys.txt)" <<<"$DR_OUT"
  check_eq "  and doctor exits 1" "1" "$DR_RC"
done
# A skill key the project's manifest lacks (the project is older) is a WARN, not a FAIL.
new_dir; VKP=$DIR
stamp "$VKP"
grep -vx 'clipboard_contains' "$VKP/scripts/oracle-keys.txt" > "$VKP/scripts/oracle-keys.txt.new"
mv "$VKP/scripts/oracle-keys.txt.new" "$VKP/scripts/oracle-keys.txt"
run_doctor "$VKP"
check "Check 2 warns on a skill key missing from the manifest" grep -qF "oracle key 'clipboard_contains' is in the plugin's test-case-contract skill" <<<"$DR_OUT"
check_eq "  as a warning (exit 0)" "0" "$DR_RC"

echo "  -- review-marker.sh ships in the plugin; an older stamp's copy is a named leftover"
LEFTOVER_RM="scripts/review-marker.sh is a leftover"
check "the review skill carries review-marker.sh" test -f "$here/skills/review/scripts/review-marker.sh"
check "a fresh stamp has no scripts/review-marker.sh" test ! -e "$D/scripts/review-marker.sh"
check "a fresh stamp gets no review-marker leftover line" test "$(grep -cF "$LEFTOVER_RM" <<<"$fresh_out")" = "0"
# A project stamped before the move still has the file. Doctor names it as INFO, uncounted.
new_dir; RMP=$DIR
stamp "$RMP"
printf '#!/bin/sh\necho old stamped copy\n' > "$RMP/scripts/review-marker.sh"
run_doctor "$RMP"
check "an old stamp's scripts/review-marker.sh is named as a leftover" grep -qF "ℹ️  $LEFTOVER_RM" <<<"$DR_OUT"
check "  and the line names both of its settings.json rules" \
  grep -qF '"Bash(bash scripts/review-marker.sh*)" (allow) and "Edit(scripts/review-marker.sh)" (deny)' <<<"$DR_OUT"
check_eq "  as INFO, so doctor still exits 0" "0" "$DR_RC"
newlines=$(diff <(printf '%s\n' "$fresh_out") <(printf '%s\n' "$DR_OUT") | grep '^>' | grep -v '^> doctor: ')
check_eq "  and it is the only new line" "1" "$(printf '%s\n' "$newlines" | grep -c .)"

# ------------------------------------------------------------------------------------------
echo "prod-guard.sh — URL classification"
new_dir; EMPTY=$DIR   # a CLAUDE_PROJECT_DIR with no .env, so only the variables below are seen
# pg <expect-exit> <label> [VAR=value ...] [-- url ...]
#   Runs the guard under `env -i` so nothing inherited (BASE_URL, QA_ALLOW_PROD) leaks in.
pg() {
  local want=$1 label=$2; shift 2
  local envs=() urls=()
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do envs+=("$1"); shift; done
  if [ "${1:-}" = "--" ]; then shift; urls=("$@"); fi
  PG_OUT=$(env -i PATH="$PATH" CLAUDE_PROJECT_DIR="$EMPTY" "${envs[@]}" /bin/sh "$PROD_GUARD" "${urls[@]}" 2>&1)
  local rc=$?
  if [ "$rc" = "$want" ]; then
    pass=$((pass+1)); printf '  ok    exit %s  %s\n' "$want" "$label"
  else
    bad=$((bad+1)); printf '  FAIL  expected exit %s, got %s — %s\n' "$want" "$rc" "$label"
  fi
}

# has_out <label> <substring> — the last pg run printed <substring>. Pins the REASON for a
# refusal, not just its exit code, so a placeholder refused as "prod" (or the reverse) is caught.
has_out() {
  if printf '%s' "$PG_OUT" | grep -qF -- "$2"; then
    pass=$((pass+1)); printf '  ok    %s\n' "$1"
  else
    bad=$((bad+1)); printf '  FAIL  %s (output lacks "%s")\n' "$1" "$2"
  fi
}
# lacks_out <label> <needle>... — the last pg run printed none of the needles.
lacks_out() {
  local label=$1 needle leaked=""; shift
  for needle in "$@"; do
    if printf '%s' "$PG_OUT" | grep -qF -- "$needle"; then leaked="$leaked $needle"; fi
  done
  if [ -z "$leaked" ]; then
    pass=$((pass+1)); printf '  ok    %s\n' "$label"
  else
    bad=$((bad+1)); printf '  FAIL  %s (leaked:%s)\n' "$label" "$leaked"
  fi
}

echo "  -- passes"
pg 0 "staging host"                                BASE_URL_APP=https://staging.acme.dev
pg 0 "localhost with a port"                       BASE_URL_APP=http://localhost:3000
pg 0 "127.0.0.1"                                   BASE_URL_APP=http://127.0.0.1:8080/app
pg 0 "'product' is not the marker"                 BASE_URL_APP=https://product.acme.dev
pg 0 "'reproduction' is not the marker"            BASE_URL_APP=https://reproduction.acme.dev
pg 0 "'produce' / 'prodigy' are not the marker"    BASE_URL_APP=https://produce.acme.dev BASE_URL_ADMIN=https://prodigy.acme.dev
pg 0 "prod only in the PATH is not the host"       BASE_URL_APP=https://staging.acme.dev/prod/home
pg 0 "real host that merely contains 'example'"    BASE_URL_APP=https://qa.example.company.com
pg 0 "legacy single-site BASE_URL"                 BASE_URL=https://staging.acme.dev
pg 0 "staging primary + staging secondary + API"   BASE_URL_APP=https://staging.acme.dev BASE_URL_ADMIN=https://admin.staging.acme.dev API_URL=https://api.staging.acme.dev
pg 0 "staging argument URL"                        BASE_URL_APP=https://staging.acme.dev -- https://review.staging.acme.dev

echo "  -- prod marker refuses"
pg 1 "prod as a leading label"                     BASE_URL_APP=https://prod.acme.com
pg 1 "production as a label"                       BASE_URL_APP=https://app.production.acme.com
pg 1 "prod2 (digits after the marker)"             BASE_URL_APP=https://prod2.acme.com
pg 1 "prod after a hyphen"                         BASE_URL_APP=https://eu-prod.acme.com
pg 1 "prod before a hyphen"                        BASE_URL_APP=https://prod-eu.acme.com
pg 1 "uppercase PROD"                              BASE_URL_APP=https://PROD.acme.com
pg 1 "bare prod host with a port"                  BASE_URL_APP=http://prod:8080
pg 1 "prod host behind userinfo with an @ password" BASE_URL_APP='https://user:p@ss@prod.acme.com/login'
pg 1 "prod on a secondary BASE_URL_*"              BASE_URL_APP=https://staging.acme.dev BASE_URL_ADMIN=https://admin.prod.acme.com
pg 1 "prod on API_URL"                             BASE_URL_APP=https://staging.acme.dev API_URL=https://api.prod.acme.com
pg 1 "prod on a *_API_URL"                         BASE_URL_APP=https://staging.acme.dev SEED_API_URL=https://api.production.acme.com
pg 1 "prod passed as an argument URL"              BASE_URL_APP=https://staging.acme.dev -- https://prod.acme.com
pg 1 "prod argument among clean ones"              BASE_URL_APP=https://staging.acme.dev -- https://a.staging.acme.dev https://prod.acme.com

echo "  -- QA_ALLOW_PROD=1 lifts the prod marker and nothing else"
pg 0 "override: prod primary"                      QA_ALLOW_PROD=1 BASE_URL_APP=https://prod.acme.com
pg 0 "override: prod secondary + API"              QA_ALLOW_PROD=1 BASE_URL_APP=https://staging.acme.dev BASE_URL_ADMIN=https://prod.acme.com API_URL=https://api.prod.acme.com
pg 0 "override: prod argument"                     QA_ALLOW_PROD=1 BASE_URL_APP=https://staging.acme.dev -- https://prod.acme.com
pg 1 "QA_ALLOW_PROD=0 is not an override"          QA_ALLOW_PROD=0 BASE_URL_APP=https://prod.acme.com
pg 1 "QA_ALLOW_PROD=true is not an override"       QA_ALLOW_PROD=true BASE_URL_APP=https://prod.acme.com
pg 1 "override does not excuse a CHANGEME primary" QA_ALLOW_PROD=1 BASE_URL_APP=CHANGEME
pg 1 "override does not excuse an empty primary"   QA_ALLOW_PROD=1 BASE_URL_APP=
pg 1 "override does not excuse an unset primary"   QA_ALLOW_PROD=1
pg 1 "override does not excuse a placeholder secondary" QA_ALLOW_PROD=1 BASE_URL_APP=https://staging.acme.dev BASE_URL_ADMIN=https://admin.example.com
pg 1 "override does not excuse a placeholder argument" QA_ALLOW_PROD=1 BASE_URL_APP=https://staging.acme.dev -- https://example.org

echo "  -- placeholders and empty targets refuse (no env escape)"
pg 1 "nothing configured at all"
pg 1 "primary set but empty"                       BASE_URL_APP=
pg 1 "empty BASE_URL_APP does not fall through to BASE_URL" BASE_URL_APP= BASE_URL=https://staging.acme.dev
pg 1 "CHANGEME sentinel"                           BASE_URL_APP=CHANGEME
pg 1 "CHANGEME inside a URL"                       BASE_URL_APP=https://CHANGEME.acme.dev
pg 1 "angle-bracket placeholder"                   BASE_URL_APP='https://<your-host>.acme.dev'
pg 1 "example.com"                                 BASE_URL_APP=https://example.com
pg 1 "subdomain of example.com"                    BASE_URL_APP=https://admin.staging.example.com
pg 1 "example.org"                                 BASE_URL_APP=https://example.org
pg 1 "example.net"                                 BASE_URL_APP=https://example.net
pg 1 "reserved .example TLD"                       BASE_URL_APP=https://app.example
pg 1 "CHANGEME left in a secondary"                BASE_URL_APP=https://staging.acme.dev BASE_URL_ADMIN=CHANGEME
pg 0 "unset secondary stays fine"                  BASE_URL_APP=https://staging.acme.dev

echo "  -- every refusal says WHY (prod marker, placeholder, empty are different remedies)"
pg 1 "prod marker on the primary"                  BASE_URL_APP=https://prod.acme.com
has_out "  names the cause" "looks like production"
has_out "  names the variable" "(BASE_URL_APP)"
lacks_out "  is not reported as a placeholder or empty target" "placeholder" "is empty"
pg 1 "prod marker on API_URL"                      BASE_URL_APP=https://staging.acme.dev API_URL=https://api.prod.acme.com
has_out "  names API_URL as the offender" "(API_URL) looks like production"
pg 1 "prod marker on an argument URL"              BASE_URL_APP=https://staging.acme.dev -- https://prod.acme.com
has_out "  names the argument as the offender" "(argument) looks like production"
pg 1 "CHANGEME placeholder"                        BASE_URL_APP=CHANGEME
has_out "  names the cause" "is a placeholder"
lacks_out "  is not reported as production" "looks like production"
pg 1 "reserved example.com placeholder"            BASE_URL_APP=https://example.com
has_out "  names the cause" "is a placeholder"
pg 1 "empty primary"                               BASE_URL_APP=
has_out "  names the cause" "BASE_URL_APP is empty"
lacks_out "  is not reported as production" "looks like production"
pg 1 "placeholder survives QA_ALLOW_PROD=1"        QA_ALLOW_PROD=1 BASE_URL_APP=CHANGEME
has_out "  still a placeholder refusal, not a pass" "is a placeholder"
pg 0 "prod passes under QA_ALLOW_PROD=1"           QA_ALLOW_PROD=1 BASE_URL_APP=https://prod.acme.com
lacks_out "  prints no refusal" "REFUSING"
has_out "  prints the verdict" "prod-guard: PASS (exit 0)"

echo "  -- credentials are masked in the output"
# The userinfo strip is greedy to the LAST @ before the path: a password that itself contains an @
# must not leak the part after it. Distinctive tokens, so a fragment cannot match by accident.
pg 0 "staging URL with userinfo still passes"      BASE_URL_APP=https://qa:hunter2@staging.acme.dev
lacks_out "  the password never reaches the output" "hunter2"
pg 0 "staging URL, password contains an @"         BASE_URL_APP='https://qa:Zq9@x7Kv@staging.acme.dev/login'
lacks_out "  no fragment of the @-password leaks" "Zq9" "x7Kv"
pg 1 "prod URL, password contains an @"            BASE_URL_APP='https://user:Zq9@x7Kv@prod.acme.com/login'
lacks_out "  no fragment of the @-password leaks in a refusal" "Zq9" "x7Kv"
has_out "  the refusal still names the real host" "'prod.acme.com'"
pg 1 "prod argument URL, password contains an @"   BASE_URL_APP=https://staging.acme.dev -- 'https://user:Zq9@x7Kv@prod.acme.com'
lacks_out "  no fragment of the @-password leaks from an argument" "Zq9" "x7Kv"

echo "  -- .env in CLAUDE_PROJECT_DIR is loaded"
new_dir; ENVDIR=$DIR
printf 'BASE_URL_APP=https://prod.acme.com\n' > "$ENVDIR/.env"
EMPTY_SAVED=$EMPTY; EMPTY=$ENVDIR
pg 1 ".env pointing at prod refuses"
printf 'BASE_URL_APP=https://staging.acme.dev\n' > "$ENVDIR/.env"
pg 0 ".env pointing at staging passes"
EMPTY=$EMPTY_SAVED

echo "---"
if [ "$bad" -ne 0 ]; then echo "qa-scaffoldtest: ❌ $bad of $((pass+bad)) cases FAILED"; exit 1; fi
echo "qa-scaffoldtest: ✅ all $pass cases passed"
