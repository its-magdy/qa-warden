# ------------------------------------------------------------------------------------------
echo "run.sh — one verdict from Playwright's exit code and its JSON"
# A stamped project gives run.sh its stamped helpers (check-last-run.sh, resolve-spec-path.sh,
# post-run-checks.sh). The real Playwright is replaced by a stub `npx` first on PATH: it writes a
# marker line to stderr, prints $STUB_JSON (or copies it to $STUB_SINK, the way the config json
# sink writes last-run.json — and like Playwright, only when no inline --reporter replaces the
# config reporters; an empty $STUB_JSON writes nothing), records its arguments in $STUB/args and
# exits $STUB_EXIT.
RUNSH="$here/skills/run/scripts/run.sh"
VERDICT_SH="$here/skills/run/scripts/run-verdict.sh"
new_dir; RP="$DIR"
stamp "$RP"
mkdir -p "$RP/tests/auth" && : > "$RP/tests/auth/login.spec.ts"
new_dir; STUB="$DIR"
cat > "$STUB/npx" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" > "$(dirname "$0")/args"
echo "stub-npx-stderr-marker" >&2
inline_reporter=0
for a in "$@"; do
  case "$a" in --reporter*) inline_reporter=1 ;; esac
done
if [ -n "${STUB_JSON:-}" ]; then
  if [ -n "${STUB_SINK:-}" ]; then
    [ "$inline_reporter" -eq 1 ] || cp "$STUB_JSON" "$STUB_SINK"
  else
    cat "$STUB_JSON"
  fi
fi
exit "${STUB_EXIT:-0}"
EOF
chmod +x "$STUB/npx"

# Fixtures. `incomplete` needs no file of its own: it is the green JSON with a non-zero exit.
new_dir; FX="$DIR"
printf '%s\n' '{"stats":{"expected":3,"unexpected":0,"skipped":0,"flaky":0,"startTime":"2026-01-01T00:00:00Z"},"suites":[]}' > "$FX/green.json"
printf '%s\n' '{"stats":{"expected":1,"unexpected":2,"skipped":0,"flaky":0,"startTime":"2026-01-01T00:00:00Z"},"suites":[]}' > "$FX/red.json"
printf '%s\n' '{"stats":{"expected":0,"unexpected":0,"skipped":0,"flaky":0,"startTime":"2026-01-01T00:00:00Z"},"suites":[]}' > "$FX/zero.json"
printf '%s\n' '{"suites":[]}' > "$FX/statsless.json"
printf '%s\n' 'Error: not a report {' > "$FX/corrupt.json"
cp "$FX/green.json" "$FX/old.json"; touch -t 202001010000 "$FX/old.json"

echo "  -- run_verdict: <word> <total> <failed>"
# verdict <exit> <json> [max_age] — sources the module in a subshell in the stamped project.
# shellcheck disable=SC1090  # $VERDICT_SH is this checkout's skills/run/scripts/run-verdict.sh
verdict() {
  (cd "$RP" && . "$VERDICT_SH" && run_verdict "$1" "$2" "${3:-900}" && echo "$VERDICT $TOTAL $FAILED")
}
check_eq "exit 0 + all passed → green"                        "green 3 0"      "$(verdict 0 "$FX/green.json")"
check_eq "exit 1 + 2 failed → red"                             "red 3 2"        "$(verdict 1 "$FX/red.json")"
check_eq "exit 1 + 0 failed → incomplete (timeout / crash)"    "incomplete 3 0" "$(verdict 1 "$FX/green.json")"
check_eq "an empty exit code is not a clean exit"              "incomplete 3 0" "$(verdict '' "$FX/green.json")"
# Playwright itself exits only 0, 1 or 130 (interrupted); anything but 0/1 is a run that stopped
# early, so failures recorded before it stopped are a partial count, not a completed red.
check_eq "exit 130 (SIGINT) + 2 failed → incomplete, never red" "incomplete 3 2" "$(verdict 130 "$FX/red.json")"
check_eq "exit 137 (SIGKILL) + 2 failed → incomplete"            "incomplete 3 2" "$(verdict 137 "$FX/red.json")"
check_eq "exit 143 (SIGTERM) + 0 failed → incomplete"            "incomplete 3 0" "$(verdict 143 "$FX/green.json")"
check_eq "a non-numeric exit code + 2 failed → incomplete"       "incomplete 3 2" "$(verdict x "$FX/red.json")"
check_eq "exit 130 + 0 resolved tests → still zero-test"         "zero-test 0 0"  "$(verdict 130 "$FX/zero.json")"
check_eq "no file → missing"                                   "missing -1 0"   "$(verdict 0 "$FX/absent.json")"
check_eq "unparseable file → corrupt"                          "corrupt -1 0"   "$(verdict 0 "$FX/corrupt.json")"
check_eq "a JSON with no .stats → corrupt, never zero-test"    "corrupt -1 0"   "$(verdict 0 "$FX/statsless.json")"
check_eq "0 resolved tests → zero-test, whatever the exit"     "zero-test 0 0"  "$(verdict 1 "$FX/zero.json")"
check_eq "older than max_age → stale"                          "stale 3 0"      "$(verdict 0 "$FX/old.json" 900)"
# shellcheck disable=SC1090  # same module as verdict() above
check_eq "no stamped check-last-run.sh → unchecked" "unchecked -1 0" \
  "$(cd "$STUB" && . "$VERDICT_SH" && run_verdict 0 "$FX/green.json" 900 && echo "$VERDICT $TOTAL $FAILED")"

# runsh <exit> <fixture|""> <sink|""> <run.sh args...> — output in $ROUT, exit status in $RRC.
runsh() {
  local ex=$1 fx=$2 sk=$3; shift 3
  ROUT=$(cd "$RP" && PATH="$STUB:$PATH" STUB_EXIT=$ex STUB_JSON=$fx STUB_SINK=$sk "$BASH" "$RUNSH" "$@" 2>&1)
  RRC=$?
}
out_has() { check "$1" grep -qF -e "$2" <<<"$ROUT"; }

echo "  -- mode=single"
runsh 0 "$FX/green.json" "" mode=single auth/login
check_eq "green: exit 0" "0" "$RRC"
out_has  "green: names the verdict" "(verdict=green)"
check    "green: the report lands at reports/headless-auth-login.json" test -s "$RP/reports/headless-auth-login.json"
runsh 1 "$FX/red.json" "" mode=single auth/login
check_eq "red: exit 0 (a completed run, the caller summarizes the failures)" "0" "$RRC"
out_has  "red: names the verdict" "(verdict=red)"
runsh 1 "$FX/green.json" "" mode=single auth/login
check_eq "unexpected=0 + exit 1: exit 2" "2" "$RRC"
out_has  "unexpected=0 + exit 1: incomplete, not green" "the run did NOT complete cleanly"
runsh 1 "" "" mode=single auth/login
check_eq "nothing written (empty report): exit 2" "2" "$RRC"
out_has  "nothing written: corrupt" "(verdict=corrupt)"
runsh 0 "$FX/green.json" "" auth/login mode=single
check_eq "mode= after the spec still picks single: exit 0" "0" "$RRC"
out_has  "mode= after the spec still picks single: its line" "run(single):"
runsh 130 "$FX/red.json" "" mode=single auth/login
check_eq "interrupted (exit 130) with 2 failed: exit 2, not a red to summarize" "2" "$RRC"
out_has  "interrupted with 2 failed: incomplete" "the run did NOT complete cleanly"
runsh 0 "$FX/zero.json" "" mode=single auth/login
check_eq "zero tests: exit 2" "2" "$RRC"
out_has  "zero tests: a resolution error" "resolved no tests"
runsh 0 "$FX/statsless.json" "" mode=single auth/login
check_eq "stats-less JSON: exit 2" "2" "$RRC"
out_has  "stats-less JSON: corrupt" "unparseable JSON"

echo "  -- mode=smoke (the config sink writes artifacts/last-run.json)"
runsh 0 "$FX/green.json" "artifacts/last-run.json" mode=smoke
check_eq "green: exit 0" "0" "$RRC"
out_has  "green: echoes the check-last-run line" "last-run: fresh total=3"
runsh 1 "$FX/green.json" "artifacts/last-run.json" mode=smoke
check_eq "unexpected=0 + exit 1: exit 2" "2" "$RRC"
out_has  "unexpected=0 + exit 1: incomplete, names --max-failures" "timeout / --max-failures / worker crash"
rm -f "$RP/artifacts/last-run.json"
runsh 1 "" "" mode=smoke
check_eq "no last-run.json: exit 2" "2" "$RRC"
out_has  "no last-run.json: no report" "produced NO report"
cp "$FX/old.json" "$RP/artifacts/last-run.json"; touch -t 202001010000 "$RP/artifacts/last-run.json"
runsh 1 "" "" mode=smoke
check_eq "a previous run's last-run.json (aborted run): exit 2" "2" "$RRC"
out_has  "a previous run's last-run.json: stale, not summarized" "Do NOT summarize the stale file"
runsh 0 "$FX/zero.json" "artifacts/last-run.json" mode=smoke
check_eq "zero tests: exit 2" "2" "$RRC"
out_has  "zero tests: --grep @smoke matched nothing" "resolved NO tests"

echo "  -- mode=repeat"
runsh 1 "$FX/red.json" "" mode=repeat auth/login 3
check_eq "red: exit 0 (a flaky result is a result)" "0" "$RRC"
out_has  "red: prints the aggregate" '"failed": 2'
runsh 1 "$FX/green.json" "" mode=repeat auth/login 3
check_eq "unexpected=0 + exit 1: exit 2 (never 100% stable)" "2" "$RRC"
out_has  "unexpected=0 + exit 1: incomplete" "the run did NOT complete cleanly"
runsh 0 "$FX/corrupt.json" "" mode=repeat auth/login 3
check_eq "corrupt: exit 2" "2" "$RRC"
out_has  "corrupt: no stability measured" "(verdict=corrupt)"

echo "  -- mode=changed"
git -C "$RP" -c user.name=qa -c user.email=qa@example.invalid commit -q --allow-empty -m base >/dev/null 2>&1
runsh 0 "$FX/zero.json" "" mode=changed
check_eq "nothing selected: exit 0" "0" "$RRC"
out_has  "nothing selected: says it is not a pass" "NOTHING SELECTED"
runsh 1 "$FX/green.json" "" mode=changed
check_eq "unexpected=0 + exit 1: exit 2" "2" "$RRC"
out_has  "unexpected=0 + exit 1: incomplete" "the run did NOT complete cleanly"

echo "  -- precheck (/qa-warden:batch-fix step 1)"
runsh 1 "$FX/red.json" "" precheck tests/auth
check_eq "red: exit 0, batch-fix proceeds" "0" "$RRC"
out_has  "red: matched and failing counts" "filter matched 3 test(s); 2 failing — proceed to step 2."
check_eq "red without a heal log: no signature block" "0" "$(grep -c 'heal-log signatures' <<<"$ROUT")"
printf '%s\n' '{"classification":"broken-locator","root_cause":"button renamed","spec":"auth/login"}' \
  '{"classification":"broken-locator","root_cause":"button renamed","spec":"auth/logout"}' > "$RP/artifacts/heal-log.jsonl"
runsh 1 "$FX/red.json" "" precheck tests/auth
out_has  "red with a heal log: the top signature, grouped" '"signature": "broken-locator | button renamed"'
out_has  "red with a heal log: its count" '"count": 2'
runsh 0 "$FX/green.json" "" precheck tests/auth
check_eq "green: exit 1, batch-fix stops" "1" "$RRC"
out_has  "green: nothing to fix" "0 failing — nothing to fix"
runsh 1 "$FX/green.json" "" precheck tests/auth
check_eq "unexpected=0 + exit 1: exit 2, not 'nothing to fix'" "2" "$RRC"
out_has  "unexpected=0 + exit 1: incomplete" "the run did NOT complete cleanly"
check_eq "unexpected=0 + exit 1: never says nothing to fix" "0" "$(grep -c 'nothing to fix' <<<"$ROUT")"
runsh 130 "$FX/red.json" "" precheck tests/auth
check_eq "interrupted (exit 130) with 2 failed: exit 2, not a batch to fix" "2" "$RRC"
out_has  "interrupted with 2 failed: incomplete, names the exit code" "playwright exited 130"
check_eq "interrupted with 2 failed: never says proceed" "0" "$(grep -c 'proceed to step 2' <<<"$ROUT")"
runsh 1 "$FX/zero.json" "" precheck tests/nowhere
check_eq "zero tests: exit 1" "1" "$RRC"
out_has  "zero tests: the pattern resolved to nothing" "filter matched 0 tests"
runsh 1 "" "" precheck tests/auth
check_eq "nothing written: exit 2" "2" "$RRC"
out_has  "nothing written: Playwright failed to start, not nothing matched" "Playwright failed to start"
runsh 0 "$FX/statsless.json" "" precheck tests/auth
check_eq "stats-less JSON: exit 2, never 'matched nothing'" "2" "$RRC"
runsh 0 "$FX/green.json" "" precheck
check_eq "no filter: exit 2 (would run the whole suite)" "2" "$RRC"
runsh 1 "$FX/red.json" "" precheck tests/auth
check    "Playwright's stderr lands in the .log" grep -qF stub-npx-stderr-marker "$RP/artifacts/batch-fix-precheck.log"
check_eq "  and never in the .json" "0" "$(grep -c stub-npx-stderr-marker "$RP/artifacts/batch-fix-precheck.json")"
check    "  so the .json still parses" jq -e .stats "$RP/artifacts/batch-fix-precheck.json"
# A filter is data: one that looks like `mode=…` must not pick another mode.
rm -f "$STUB/args"
runsh 1 "$FX/red.json" "" precheck mode=smoke
check_eq "a 'mode=smoke' filter stays precheck: exit 0" "0" "$RRC"
out_has  "a 'mode=smoke' filter stays precheck: precheck's line" "run(precheck):"
check    "a 'mode=smoke' filter is passed to Playwright as the filter" grep -qx -- 'playwright test mode=smoke --retries=0 --reporter=json' "$STUB/args"

echo "  -- recheck (/qa-warden:batch-fix step 5)"
# A run-of-record environment: if the inline --reporter were dropped, the stub (like the config's
# gated json sink) would overwrite last-run.json with this batch's subset.
cp "$FX/green.json" "$RP/artifacts/last-run.json"
lr_before=$(cksum < "$RP/artifacts/last-run.json")
RECHECK_SINK=artifacts/last-run.json
runsh 0 "$FX/red.json" "$RECHECK_SINK" recheck tests/auth
check_eq "green: exit 0" "0" "$RRC"
out_has  "green: says so" "run(recheck): green"
check    "runs the filter with --retries=0 --reporter=line" grep -qx -- 'playwright test tests/auth --retries=0 --reporter=line' "$STUB/args"
check_eq "last-run.json (the run-of-record) is untouched" "$lr_before" "$(cksum < "$RP/artifacts/last-run.json")"
runsh 1 "$FX/red.json" "$RECHECK_SINK" recheck tests/auth
check_eq "still red: exit 1" "1" "$RRC"
out_has  "still red: NOT green, and says a crash looks the same" "the line reporter cannot tell these apart"
check_eq "  last-run.json still untouched" "$lr_before" "$(cksum < "$RP/artifacts/last-run.json")"
rm -f "$STUB/args"
runsh 0 "$FX/green.json" "" recheck
check_eq "no filter: exit 2" "2" "$RRC"
check    "no filter: Playwright never ran (no whole-suite run)" test ! -e "$STUB/args"
runsh 0 "$FX/green.json" "" recheck mode=single
check_eq "a 'mode=single' filter stays recheck: exit 0" "0" "$RRC"
check    "a 'mode=single' filter is passed to Playwright as the filter" grep -qx -- 'playwright test mode=single --retries=0 --reporter=line' "$STUB/args"

# ------------------------------------------------------------------------------------------
echo "the test inventory and the smoke-tag parser (scripts/spec-links.sh) — and every reader of them"
# Three `find tests` walks used to disagree (only two applied playwright.config.ts's `_` testIgnore,
# so /qa-warden:impact and /qa-warden:coverage listed tests/_demo/… files Playwright never runs), and
# two smoke parsers did too (coverage counted a prose "not a smoke test"; doctor missed the
# per-scenario and block-list forms). The fixture carries every case that told them apart.
COVERAGE="$here/skills/coverage/scripts/coverage.sh"
IMPACT="$here/skills/impact/scripts/impact.sh"
new_dir; G=$DIR
stamp "$G"
check_eq "section 8: the stamp this fixture is built on exits 0" "0" "$RC"
mkdir -p "$G/specs/shop" "$G/specs/_drafts" "$G/tests/shop/_probe" "$G/tests/_demo" \
         "$G/artifacts/route-manifests/shop" "$G/specs/_context/shop/shop"
# Inline tags, a compiled test, its metamorphic twin and a manifest.
printf 'name: cart\ntags: [smoke, regression]\n' > "$G/specs/shop/cart.md"
printf "test('cart @smoke', async () => {});\n" > "$G/tests/shop/cart.spec.ts"
printf "test('cart twin @regression', async () => {});\n" > "$G/tests/shop/cart.metamorphic.spec.ts"
printf '{"routes":["/cart"],"area":"shop","spec":"specs/shop/cart.md"}\n' > "$G/artifacts/route-manifests/shop/cart.json"
# A compiled test with no manifest, and a fanned spec back-linking it (smoke, no test of its own).
printf 'name: login\ntags: [regression]\n' > "$G/specs/shop/login.md"
printf "test('login @regression', async () => {});\n" > "$G/tests/shop/login.spec.ts"
printf 'basis: shop/login   # fanned from the login checklist\nname: login-locked\ntags: ["@smoke"]\n' \
  > "$G/specs/shop/login-locked.md"
# The per-scenario flow form the test-case contract requires for a multi-scenario spec; no test.
printf 'name: pay\nscenarios: [{ name: "ok", data: { n: 1 }, tags: [smoke] }, { name: "bad", tags: [regression] }]\n' \
  > "$G/specs/shop/pay.md"
# The block-list form, under a scenario; no test.
printf 'name: refund\nscenarios:\n  - name: ok\n    tags:\n      - smoke\n  - name: late\n    tags:\n      - regression\n' \
  > "$G/specs/shop/refund.md"
# Prose and a comment that mention smoke, and a regression tag; no test. Must NOT count as smoke.
printf 'name: search\n# Not a smoke test: @smoke was dropped.\nThis is not a smoke test; see tags: [smoke] in cart.\ntags: [regression]  # smoke later\n' \
  > "$G/specs/shop/search.md"
# A genuinely stray test (no spec), so the stray scan is shown to still fire.
printf "test('orphan @regression', async () => {});\n" > "$G/tests/shop/orphan.spec.ts"
# Scratch files Playwright's testIgnore drops: a `_` basename, a `_` dir under an area, a `_` dir
# at the tests/ root, and a `_` spec dir. None has a spec or a manifest; all carry @smoke.
for t in tests/shop/_scratch.spec.ts tests/shop/_probe/x.spec.ts tests/_demo/failure-demo.spec.ts; do
  printf "test('scratch @smoke', async () => {});\n" > "$G/$t"
done
printf 'name: draft\ntags: [smoke]\n' > "$G/specs/_drafts/draft.md"
# A scratch spec back-linking a checklist: it must not satisfy Check 18 (`index` skips `_` too).
printf 'basis: shop/ghost\ntags: [regression]\n' > "$G/specs/shop/_ghost.md"
printf '# cases: shop/ghost\n' > "$G/specs/_context/shop/shop/ghost.cases.md"
# Parser edge cases. CRLF line ends on a block list and a fanned `basis:` (deleting the CR strip
# turns it non-smoke and leaves a CR on the basis); tokens that merely CONTAIN smoke (an
# anywhere-in-token match would count them); a `#` inside a quoted scenario name.
printf 'basis: shop/login   # fanned\r\nname: crlf\r\nscenarios:\r\n  - name: ok\r\n    tags:\r\n      - smoke\r\n' \
  > "$G/specs/shop/crlf.md"
printf 'name: nonsmoke\ntags: [no-smoke, nonsmoke, regression]\n' > "$G/specs/shop/nonsmoke.md"
printf 'scenarios: [{ name: "issue #3", tags: [smoke] }]\n' > "$G/specs/shop/hash.md"
# Where a tag is NOT a test tag. A fenced spec: only its ```yaml blocks are read, so the prose
# lines (one even reads as a top-level `tags:` key), the Markdown bullet and the ```ts fence do
# not count, and inside the YAML neither does a `tags:` under `meta:` or in a scenario's `data:`.
printf '%s\n' '# Fenced' '' 'We ran it fast, tags: smoke-ish' '- tags: smoke was dropped' 'tags: [smoke] was dropped in review.' '' \
  '```yaml' 'name: fenced' 'tags: [regression]' 'meta:' '  tags: [smoke]' \
  'scenarios: [{ name: "ok", data: { tags: [smoke] } }]' '```' '' '```ts' 'tags: [smoke]' '```' \
  > "$G/specs/shop/fenced.md"
# ...and the same fenced shape with a real per-scenario smoke tag (block form), which does count.
printf '%s\n' '# Fenced smoke' '' 'Prose first.' '' '```yaml' 'name: fenced-smoke' 'scenarios:' \
  '  - name: ok' '    tags: [smoke]' '```' > "$G/specs/shop/fenced-smoke.md"
# A bare-YAML spec (no fence, read whole): a prose line ends the key above it, and a `tags:` nested
# under a block scenario's `data:` or a top-level `data:` is not a test tag.
printf '%s\n' 'name: bare' 'We ran it fast, tags: smoke-ish' '- tags: smoke was dropped' \
  'data: { tags: [smoke] }' 'scenarios:' '  - name: ok' '    data:' '      tags: [smoke]' \
  > "$G/specs/shop/bare.md"
# An escaped `\"` inside a double-quoted name is not its end: read as one, the ` #3` became a
# comment (cutting the tag) and the `{` went uncounted (so the second scenario's key was never seen).
printf '%s\n' 'scenarios: [{ name: "say \" #3", tags: [smoke] }]' > "$G/specs/shop/esc.md"
printf '%s\n' 'scenarios: [{ name: "a \" {", tags: [regression] }, { name: b, tags: [smoke] }]' \
  > "$G/specs/shop/esc-depth.md"
# A `tags: [` list split over lines: per scenario in the flow and the block form, and top level.
printf '%s\n' 'scenarios: [{ name: ok, tags: [' '  smoke, regression' '] }]' > "$G/specs/shop/ml-flow.md"
printf '%s\n' 'scenarios:' '  - name: ok' '    tags: [' '      regression,' '      smoke' '    ]' \
  > "$G/specs/shop/ml-block.md"
printf '%s\n' 'tags: [' '  smoke' ']' > "$G/specs/shop/ml-top.md"
# ...and split lists that must NOT count: regression-only lists, a split `data: { tags: [` and an
# escaped quote whose name text reads `tags: [smoke]`.
printf '%s\n' 'tags: [' '  regression' ']' 'scenarios: [{ name: "a \" tags: [smoke]", tags: [' '  regression ] },' \
  '  { name: b, data: { tags: [' '    smoke ] } }]' > "$G/specs/shop/ml-none.md"
# The four scratch names, for the "reported nowhere" cases below. Matched by name rather than by
# `/_`, which the stamp's own specs/_context/ paths would hit.
SCRATCH_RE='_scratch|_probe|_demo|_drafts|_ghost'
# A mutating basis for shop/cart, so Check 13 resolves the spec AND its twin through the inventory.
printf 'feature: shop/cart\ntest_data:\n  mutates_server_state: true\n' > "$G/specs/_context/shop/shop/cart.basis.md"

sl() { (cd "$G" && "$1" scripts/spec-links.sh "$2" 2>&1); }
TAB=$'\t'
echo "  -- spec-links.sh tests / specs / smoke / unmanifested"
check_eq "tests: the collected tests only, twin marked and paired, - for a missing spec/manifest" \
  "tests/shop/cart.metamorphic.spec.ts${TAB}shop/cart${TAB}twin${TAB}specs/shop/cart.md${TAB}artifacts/route-manifests/shop/cart.json
tests/shop/cart.spec.ts${TAB}shop/cart${TAB}spec${TAB}specs/shop/cart.md${TAB}artifacts/route-manifests/shop/cart.json
tests/shop/login.spec.ts${TAB}shop/login${TAB}spec${TAB}specs/shop/login.md${TAB}-
tests/shop/orphan.spec.ts${TAB}shop/orphan${TAB}spec${TAB}-${TAB}-" \
  "$(sl "$BASH" tests | LC_ALL=C sort)"
check_eq "specs: the authored specs only, with test, smoke and basis columns" \
  "specs/shop/bare.md${TAB}shop/bare${TAB}-${TAB}-${TAB}-
specs/shop/cart.md${TAB}shop/cart${TAB}tests/shop/cart.spec.ts${TAB}smoke${TAB}-
specs/shop/crlf.md${TAB}shop/crlf${TAB}-${TAB}smoke${TAB}shop/login
specs/shop/esc-depth.md${TAB}shop/esc-depth${TAB}-${TAB}smoke${TAB}-
specs/shop/esc.md${TAB}shop/esc${TAB}-${TAB}smoke${TAB}-
specs/shop/fenced-smoke.md${TAB}shop/fenced-smoke${TAB}-${TAB}smoke${TAB}-
specs/shop/fenced.md${TAB}shop/fenced${TAB}-${TAB}-${TAB}-
specs/shop/hash.md${TAB}shop/hash${TAB}-${TAB}smoke${TAB}-
specs/shop/login-locked.md${TAB}shop/login-locked${TAB}-${TAB}smoke${TAB}shop/login
specs/shop/login.md${TAB}shop/login${TAB}tests/shop/login.spec.ts${TAB}-${TAB}-
specs/shop/ml-block.md${TAB}shop/ml-block${TAB}-${TAB}smoke${TAB}-
specs/shop/ml-flow.md${TAB}shop/ml-flow${TAB}-${TAB}smoke${TAB}-
specs/shop/ml-none.md${TAB}shop/ml-none${TAB}-${TAB}-${TAB}-
specs/shop/ml-top.md${TAB}shop/ml-top${TAB}-${TAB}smoke${TAB}-
specs/shop/nonsmoke.md${TAB}shop/nonsmoke${TAB}-${TAB}-${TAB}-
specs/shop/pay.md${TAB}shop/pay${TAB}-${TAB}smoke${TAB}-
specs/shop/refund.md${TAB}shop/refund${TAB}-${TAB}smoke${TAB}-
specs/shop/search.md${TAB}shop/search${TAB}-${TAB}-${TAB}-" \
  "$(sl "$BASH" specs | LC_ALL=C sort)"
check_eq "smoke: inline, quoted-@, per-scenario (flow, block, CRLF, quoted #, escaped quote), split lists count; prose, bullets, nested and non-yaml-fence tags and smoke-containing tokens do not" \
  "specs/shop/cart.md
specs/shop/crlf.md
specs/shop/esc-depth.md
specs/shop/esc.md
specs/shop/fenced-smoke.md
specs/shop/hash.md
specs/shop/login-locked.md
specs/shop/ml-block.md
specs/shop/ml-flow.md
specs/shop/ml-top.md
specs/shop/pay.md
specs/shop/refund.md" \
  "$(sl "$BASH" smoke | LC_ALL=C sort)"
check_eq "index: back-links from authored specs only (the _-prefixed one is skipped, as in specs)" \
  "specs/shop/crlf.md
specs/shop/login-locked.md" \
  "$(sl "$BASH" index | cut -d: -f1 | LC_ALL=C sort)"
check_eq "unmanifested: no twin, no scratch spec" \
  "tests/shop/login.spec.ts${TAB}shop/login
tests/shop/orphan.spec.ts${TAB}shop/orphan" \
  "$(sl "$BASH" unmanifested | LC_ALL=C sort)"
# The stamped file is `#!/bin/sh`; on Linux that is dash, which is where a bash-ism would show.
for m in tests specs smoke unmanifested; do
  check_eq "  /bin/sh gives the same $m answer" "$(sl "$BASH" $m | LC_ALL=C sort)" "$(sl /bin/sh $m | LC_ALL=C sort)"
done
check_eq "an unknown mode exits 2 (what the callers key their old-stamp fallback on)" "2" \
  "$(cd "$G" && "$BASH" scripts/spec-links.sh no-such-mode >/dev/null 2>&1; echo $?)"
# A TAB in a test path would shift every column after it (the old checker saw such a stray; the
# TSV hid it). It is left out of the rows and named on stderr, and post-run-checks.sh warns on it.
new_dir; TT=$DIR
mkdir -p "$TT/scripts" "$TT/tests" "$TT/specs"
cp "$here/templates/scripts/spec-links.sh" "$here/templates/scripts/post-run-checks.sh" "$TT/scripts/"
printf "test('t @smoke', async () => {});\n" > "$TT/tests/a${TAB}b.spec.ts"
check_eq "tests: a TAB-named test is not a row" "" "$(cd "$TT" && "$BASH" scripts/spec-links.sh tests 2>/dev/null)"
check "  but is named on stderr, the TAB shown" grep -qF -e "spec-links: skipped tests/a<TAB>b.spec.ts" \
  <<<"$(cd "$TT" && "$BASH" scripts/spec-links.sh tests 2>&1 >/dev/null)"
PR_OUT=$(cd "$TT" && "$BASH" scripts/post-run-checks.sh --only stray 2>&1)
check "  post-run-checks prints it as a warning" grep -qF -e "WARN: skipped tests/a<TAB>b.spec.ts" <<<"$PR_OUT"
check_eq "  and counts it" "post-run: sentinels=0 stray=1 open-bugs=0 test-gaps=0" "$(grep '^post-run:' <<<"$PR_OUT")"
# Only `spec-links: skipped` lines on stderr count: any other diagnostic — even one shaped like a
# stray row (4th TAB field `-`) — is not a test. The inventory's rows come from stdout alone.
printf '#!/bin/sh\nprintf "diagnostic\\tcontext\\tmetadata\\t-\\n" >&2\nexit 0\n' > "$TT/noisy-links.sh"
PR_OUT=$(cd "$TT" && QA_SPEC_LINKS=noisy-links.sh "$BASH" scripts/post-run-checks.sh --only stray 2>&1)
check_eq "a stray-shaped stderr diagnostic is not counted as a stray" \
  "post-run: sentinels=0 stray=0 open-bugs=0 test-gaps=0" "$(grep '^post-run:' <<<"$PR_OUT")"
check "  nor printed as one" test "$(grep -c 'diagnostic' <<<"$PR_OUT")" = "0"

echo "  -- doctor reads the inventory"
run_doctor "$G"
check "doctor names no _-prefixed test or spec" test "$(grep -cE -e "$SCRATCH_RE" <<<"$DR_OUT")" = "0"
dr_has "Check 16: the per-scenario smoke spec with no test is gate-blind" \
  "smoke-tagged spec with no compiled test: specs/shop/pay.md"
dr_has "Check 16: the block-list smoke spec with no test is gate-blind" \
  "smoke-tagged spec with no compiled test: specs/shop/refund.md"
dr_lacks "Check 16: a fanned smoke spec whose basis feature is compiled is not" "specs/shop/login-locked.md"
dr_has "Check 17: the prose-only spec is an uncompiled spec, not a smoke one" \
  "spec with no compiled test: specs/shop/search.md has no tests/shop/search.spec.ts (any tag)"
check_eq "  and Checks 16/17 report each uncompiled spec once" "3" \
  "$(grep -cE 'spec with no compiled test: specs/shop/(pay|refund|search)\.md' <<<"$DR_OUT")"
dr_has "Check 13: the mutating feature's test is resolved through the inventory" \
  "shop/cart: basis declares mutates_server_state:true but tests/shop/cart.spec.ts shows no isolation marker"
dr_has "  and so is its twin" \
  "shop/cart: basis declares mutates_server_state:true but tests/shop/cart.metamorphic.spec.ts shows no isolation marker"
dr_has "Check 14: the stray test is still reported" "unmanaged spec tests/shop/orphan.spec.ts"
check_eq "  and it is the only stray one (the scratch specs are not)" "1" "$(grep -c 'unmanaged spec' <<<"$DR_OUT")"
dr_has "Check 18: a checklist back-linked only by a _-prefixed spec is an abandoned chain" \
  "abandoned authoring chain: specs/_context/shop/shop/ghost.cases.md"
check_eq "Check 3: 1 of the 4 collected test files carries @smoke" \
  "smoke-tagged spec files: 1 / 4 (smoke-or-regression: 4)" "$(grep '^smoke-tagged spec files:' <<<"$DR_OUT")"
NEW_STAMP_OUT=$DR_OUT

echo "  -- /qa-warden:coverage and /qa-warden:impact read the inventory"
CV_OUT=$(cd "$G" && "$BASH" "$COVERAGE" "" 2>&1)
check "coverage names no _-prefixed test or spec" test "$(grep -cE -e "$SCRATCH_RE" <<<"$CV_OUT")" = "0"
check "coverage dim 0 lists the unmanifested test" grep -qF -e "⚠ tests/shop/login.spec.ts  (no artifacts/route-manifests/shop/login.json" <<<"$CV_OUT"
check "coverage dim 1b flags the per-scenario smoke spec as gate-blind" \
  grep -qF -e "GAP spec-without-test: specs/shop/pay.md → no tests/shop/pay.spec.ts  ← @smoke" <<<"$CV_OUT"
check "coverage dim 1b lists the prose-only spec WITHOUT the @smoke flag" \
  grep -qxF -e "  ⚠ GAP spec-without-test: specs/shop/search.md → no tests/shop/search.spec.ts" <<<"$CV_OUT"
IM_OUT=$(cd "$G" && "$BASH" "$IMPACT" route=/cart 2>&1)
check "impact still matches the manifested spec" grep -qF -e "specs/shop/cart.md" <<<"$IM_OUT"
check_eq "impact BLIND SPOTS: exactly the two unmanifested collected tests" \
  "  • tests/shop/login.spec.ts  (no manifest — NOT in the impact graph; regenerate with /qa-warden:gen specs/shop/login.md)
  • tests/shop/orphan.spec.ts  (no manifest — NOT in the impact graph; regenerate with /qa-warden:gen specs/shop/orphan.md)" \
  "$(sed -n '/^### BLIND SPOTS/,$p' <<<"$IM_OUT" | grep '•' | sort)"
check_eq "post-run-checks: one stray test, no scratch spec" "post-run: sentinels=0 stray=1 open-bugs=0 test-gaps=0" \
  "$(cd "$G" && "$BASH" scripts/post-run-checks.sh --only stray 2>&1 | grep '^post-run:')"

echo "  -- a stamp that predates the inventory"
# A stand-in for the stamp before the inventory: no `tests`/`specs`/`smoke` modes, no
# collected_tests(), and an `unmanifested` walk that ignores testIgnore (so it lists the `_` files,
# as the old one did). Doctor, coverage and impact must run the plugin's copy instead and give the
# new answers, with only the drift ⚠️ / a resync hint to show for it.
SLG="$G/scripts/spec-links.sh"
cp "$SLG" "$SLG.keep"
sed -e 's/^  tests)/  tests-gone)/' -e 's/^  specs)/  specs-gone)/' -e 's/^  smoke)/  smoke-gone)/' \
    -e 's/^collected_tests()/old_walk()/' -e 's/^    collected_tests | /    old_walk | /' \
    -e "/^  find tests /s/ ! -name '_\\*' ! -path '\\*\\/_\\*\\/\\*'//" "$SLG.keep" > "$SLG"
check "precondition: the stand-in has no tests mode" \
  test "$(cd "$G" && "$BASH" scripts/spec-links.sh tests >/dev/null 2>&1; echo $?)" = "2"
check "precondition: its unmanifested walk lists the scratch tests, as the old one did" \
  grep -qF -e "tests/_demo/failure-demo.spec.ts" <<<"$(sl "$BASH" unmanifested)"
run_doctor "$G"
check_eq "doctor: no ❌ about spec-links.sh on an old stamp" "0" "$(grep '^❌' <<<"$DR_OUT" | grep -c 'spec-links')"
dr_has "  only the drift warning and an INFO line" "substrate drift: scripts/spec-links.sh differs"
dr_has "  (the INFO line names the plugin's copy)" "ℹ️  scripts/spec-links.sh predates the shared test inventory"
dr_lacks "  no false Check 13 'NO compiled test resolved'" "NO compiled test resolved"
check_eq "  Check 3 counts the same suite as on the new stamp" \
  "$(grep '^smoke-tagged spec files:' <<<"$NEW_STAMP_OUT")" "$(grep '^smoke-tagged spec files:' <<<"$DR_OUT")"
check_eq "  Checks 14-18 say the same as on the new stamp" \
  "$(grep -E 'unmanaged spec|compiled test|abandoned|changed since last review|isolation marker' <<<"$NEW_STAMP_OUT")" \
  "$(grep -E 'unmanaged spec|compiled test|abandoned|changed since last review|isolation marker' <<<"$DR_OUT")"
dr_lacks "  (Check 14 read the plugin's inventory: no 'could NOT run')" "scan could NOT run"
# post-run-checks.sh run on its own (/qa-warden:run mode=smoke, /qa-warden:report) has no plugin
# copy to fall back on: it must say the stray scan did not run, and count that, never print stray=0.
PR_OUT=$(cd "$G" && "$BASH" scripts/post-run-checks.sh --only stray 2>&1)
check "post-run-checks on an old stamp says the stray scan could NOT run, and names the resync" \
  grep -qF -e "WARN: unmanaged-spec scan could NOT run — scripts/spec-links.sh has no \`tests\` inventory" <<<"$PR_OUT"
check "  (the resync hint)" grep -qF -e "Run /qa-warden:init --resync" <<<"$PR_OUT"
check_eq "  and counts it" "post-run: sentinels=0 stray=1 open-bugs=0 test-gaps=0" "$(grep '^post-run:' <<<"$PR_OUT")"
CV_OUT=$(cd "$G" && "$BASH" "$COVERAGE" "" 2>&1); CV_RC=$?
check_eq "coverage runs on an old stamp (exit 0)" "0" "$CV_RC"
check "  and prints the resync hint" grep -qF -e "predates the shared test inventory — this report used the plugin's copy. Run /qa-warden:init --resync" <<<"$CV_OUT"
check "  and names no _-prefixed test or spec" test "$(grep -cE -e "$SCRATCH_RE" <<<"$CV_OUT")" = "0"
IM_OUT=$(cd "$G" && "$BASH" "$IMPACT" route=/cart 2>&1)
check "impact on an old stamp prints the resync hint" grep -qF -e "BLIND SPOTS below used the plugin's copy" <<<"$IM_OUT"
check "  and its BLIND SPOTS name no _-prefixed test" test "$(grep -cE -e "$SCRATCH_RE" <<<"$IM_OUT")" = "0"
mv "$SLG.keep" "$SLG"

# ------------------------------------------------------------------------------------------
echo "symlink containment — retire-delete.sh and review-marker.sh against one path table"
# Both scripts checked their paths as strings only (specs/…, tests/…, no '..'), and a symlinked dir
# on the path got past that: with `tests -> /tmp/outside`, retire-delete deleted
# /tmp/outside/x.spec.ts, and a symlinked reports/ made review-marker write its marker outside the
# project. Each now carries the same in_root function. One table, run against both. Every row
# builds a fresh project at $X/proj beside $X/outside and a sibling-prefix $X/proj2, plants at most
# one symlink, and names one path. retire-delete is asked to delete that path. review-marker gets it
# as its spec (specs/…) or its test (tests/…); for reports/review/<rel>.reviewed it gets the spec
# whose marker lands there.
# Columns: label | retire-delete | review-marker | symlink to plant (- for none) | its target | path |
# create the path first (yes/no). Targets: @OUT is $X/outside, @PROJ2 is $X/proj2, anything else is
# a relative target used as written.
# A dir symlink that resolves INSIDE the project is allowed (the alias row). retire-delete also
# demands that the resolved dir is still a retire-able one (the tests/src row), because a delete
# under tests/src -> ../src would remove product source; review-marker only hashes and writes a
# marker, so for it inside the project is enough. "new nested dirs under a real reports/" is refused
# by retire-delete only because there is no file to delete.
CONTAIN_ROWS='plain test file|allow|allow|-|-|tests/demo/widget.spec.ts|yes
plain spec file|allow|allow|-|-|specs/demo/widget.md|yes
plain marker under a real reports/|allow|allow|-|-|reports/review/demo/widget.reviewed|yes
new nested dirs under a real reports/|refuse|allow|-|-|reports/review/new/deep/w.reviewed|no
tests/ is a symlink out of the project|refuse|refuse|tests|@OUT|tests/demo/widget.spec.ts|yes
specs/ is a symlink out of the project|refuse|refuse|specs|@OUT|specs/demo/widget.md|yes
reports/ is a symlink out of the project|refuse|refuse|reports|@OUT|reports/review/demo/widget.reviewed|yes
new nested dirs under a symlinked reports/|refuse|refuse|reports|@OUT|reports/review/new/deep/w.reviewed|no
reports/ is a dangling symlink|refuse|refuse|reports|@OUT/missing|reports/review/demo/widget.reviewed|no
an intermediate dir is a symlink out (tests/a)|refuse|refuse|tests/a|@OUT|tests/a/x.spec.ts|yes
the leaf test file is a symlink out|refuse|refuse|tests/demo/leaf.spec.ts|@OUT/leaf.spec.ts|tests/demo/leaf.spec.ts|yes
the leaf marker is a symlink out|refuse|refuse|reports/review/demo/widget.reviewed|@OUT/m.reviewed|reports/review/demo/widget.reviewed|yes
tests/ points at the sibling-prefix dir proj2|refuse|refuse|tests|@PROJ2|tests/demo/widget.spec.ts|yes
a dir symlink back inside a retire-able dir (tests/alias -> demo)|allow|allow|tests/alias|demo|tests/alias/widget.spec.ts|yes
a dir symlink inside the project but out of the retire-able dirs (tests/src -> ../src)|refuse|allow|tests/src|../src|tests/src/app.spec.ts|yes'
RD="$TEMPLATES/scripts/retire-delete.sh"
check "section 9: retire-delete.sh exists" test -f "$RD"
check "section 9: review-marker.sh exists" test -f "$RMK"
check_nonzero "section 9: the path table has rows" "$(grep -c '|' <<<"$CONTAIN_ROWS")"
# contain_fixture <link> <target> <path> <create> — a fresh $X with the project at $P.
contain_fixture() {
  local link=$1 target=$2 path=$3 create=$4 tgt
  new_dir; X=$DIR; P="$X/proj"
  mkdir -p "$P/specs/demo" "$P/tests/demo" "$P/reports/review" "$P/src" "$X/outside" "$X/proj2/demo"
  printf '# Widget\n' > "$P/specs/demo/widget.md"
  printf "import { test } from '@playwright/test';\n" > "$P/tests/demo/widget.spec.ts"
  if [ "$link" != "-" ]; then
    case "$target" in
      @OUT*)   tgt="$X/outside${target#@OUT}" ;;
      @PROJ2*) tgt="$X/proj2${target#@PROJ2}" ;;
      *)       tgt=$target ;;
    esac
    rm -rf "${P:?}/$link"
    mkdir -p "$(dirname "$P/$link")"
    ln -s "$tgt" "$P/$link"
  fi
  if [ "$create" = "yes" ]; then
    mkdir -p "$(dirname "$P/$path")"
    printf 'planted\n' > "$P/$path"
  fi
}
# contain_expect <label> <expect> <rc> <effect-command...> — one script's verdict on one row: an
# allowed path exits 0, leaves $X/outside and $X/proj2 as they were, and has its effect; a refused
# one exits 2 and leaves everything under $X (project included) as it was.
contain_expect() {
  local label=$1 expect=$2 rc=$3; shift 3
  if [ "$expect" = "allow" ]; then
    check_eq "$label: allowed (exit 0)" "0" "$rc"
    check_same "  and nothing outside the project changed" "$OUT_BEFORE" "$(snapshot "$X/outside"; snapshot "$X/proj2")"
    check "  and it did its job" "$@"
  else
    check_eq "$label: refused (exit 2)" "2" "$rc"
    check_same "  and nothing was deleted or written, inside the project or out" "$ALL_BEFORE" "$(snapshot "$X")"
  fi
}
while IFS='|' read -r label rd_exp rm_exp link target path create; do
  contain_fixture "$link" "$target" "$path" "$create"
  ALL_BEFORE=$(snapshot "$X"); OUT_BEFORE=$(snapshot "$X/outside"; snapshot "$X/proj2")
  (cd "$P" && "$BASH" "$RD" "$path") >/dev/null 2>&1
  contain_expect "retire-delete, $label" "$rd_exp" "$?" test ! -e "$P/$path"

  contain_fixture "$link" "$target" "$path" "$create"
  spec=specs/demo/widget.md; tst=tests/demo/widget.spec.ts
  case "$path" in
    specs/*) spec=$path ;;
    tests/*) tst=$path ;;
    reports/review/*)
      rel=${path#reports/review/}; spec="specs/${rel%.reviewed}.md"
      mkdir -p "$(dirname "$P/$spec")"
      printf '# Spec\n' > "$P/$spec" ;;
  esac
  marker="reports/review/${spec#specs/}"; marker="${marker%.md}.reviewed"
  ALL_BEFORE=$(snapshot "$X"); OUT_BEFORE=$(snapshot "$X/outside"; snapshot "$X/proj2")
  (cd "$P" && "$BASH" "$RMK" "$spec" "$tst" PASS) >/dev/null 2>&1
  contain_expect "review-marker, $label" "$rm_exp" "$?" grep -qx 'result: PASS' "$P/$marker"
done <<<"$CONTAIN_ROWS"
# check mode reads the marker; a symlinked reports/ is refused there too, not read through.
contain_fixture reports @OUT reports/review/demo/widget.reviewed yes
CK_OUT=$(cd "$P" && "$BASH" "$RMK" check specs/demo/widget.md tests/demo/widget.spec.ts 2>/dev/null)
check_eq "review-marker check through a symlinked reports/: exit 2, nothing on stdout" "2:" "$?:$CK_OUT"

echo "---"
if [ "$bad" -ne 0 ]; then echo "qa-scaffoldtest: ❌ $bad of $((pass+bad)) cases FAILED"; exit 1; fi
echo "qa-scaffoldtest: ✅ all $pass cases passed"
