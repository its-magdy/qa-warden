check_eq "precondition: doctor exits 1 with playwright.config.ts missing" "1" "$DR_RC"
run_launcher "$D" "$CFG"
check_eq "launcher passes a failing doctor's exit code through (1)" "1" "$LN_RC"
mv "$D/playwright.config.ts.away" "$D/playwright.config.ts"
# A project-scope record for THIS directory outranks a user-scope one.
new_dir; NODOC=$DIR   # a "plugin" with no doctor in it
record "$CFG" "[{\"scope\": \"user\", \"installPath\": \"$NODOC\", \"lastUpdated\": \"2026-10-09T00:00:00Z\"},
                {\"scope\": \"project\", \"projectPath\": \"$D\", \"installPath\": \"$here\", \"lastUpdated\": \"2026-10-01T00:00:00Z\"}]"
