# --- scripts/bug-status.sh ---------------------------------------------------------------
echo "  -- bug-status.sh"
bs() { (cd "$F" && "$BASH" scripts/bug-status.sh "$@" 2>&1); }
# CRs are dropped before comparing: what is pinned is that the CRLF heading is RECOGNISED and the
# value found, not what the parser does with the carriage return left on the value line.
check_eq "CRLF file: the canonical two-line heading is read, lowercased" \
  "open - confirmed live" "$(bs bugs/2026-01-02-checkout-total.md | tr -d '\r')"
check_eq "CRLF file: classified open" "open" "$(bs --class bugs/2026-01-02-checkout-total.md | tr -d '\r')"
check_eq "a Status History section is skipped for the real inline Status after it" \
  "fixed - landed in #12" "$(bs bugs/2026-01-03-login-loop.md)"
check_eq "  and that bug is classified resolved" "resolved" "$(bs --class bugs/2026-01-03-login-loop.md)"
check_eq "a bare Status: line is read" "open" "$(bs bugs/2026-02-03-search-empty-state.md)"
check_eq "an inline '## Status: open' is read" "open" "$(bs bugs/2026-02-10-footer-link.md)"
check_eq "a file with only a Status History prints no value" "" "$(bs bugs/2026-03-05-history-only.md)"
check_eq "  and classifies as open, the fail-safe direction" "open" "$(bs --class bugs/2026-03-05-history-only.md)"
check_eq "--list-open lists every bug that is not resolved (sorted; find order is not the contract)" \
  "bugs/2026-01-02-checkout-total.md
bugs/2026-02-03-search-empty-state.md
bugs/2026-02-10-footer-link.md
bugs/2026-03-05-history-only.md
bugs/2026-03-07-cart-blind-oracle.md" \
  "$(bs --list-open | tr -d '\r' | sort)"

