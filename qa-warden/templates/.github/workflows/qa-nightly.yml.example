# qa-nightly — the $0-LLM run-of-record. Rename to qa-nightly.yml to arm it, then add the
# repo secrets below (Settings → Secrets → Actions). prod-guard fails CLOSED on a missing/
# placeholder BASE_URL — an unarmed workflow goes red, never silently green.
name: qa-nightly
on:
  schedule:
    - cron: '30 2 * * *'        # 02:30 UTC nightly — adjust to your off-peak window
  workflow_dispatch: {}          # manual trigger for debugging the workflow itself
# Least privilege (GitHub's hardening guide): the run only reads the repo and the repo's metadata.
permissions:
  contents: read
jobs:
  nightly:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      # Every BASE_URL_* / QA_* the suite reads — mirror your .env (secrets, not committed).
      BASE_URL_APP: ${{ secrets.QA_BASE_URL_APP }}
      QA_USER_EMAIL: ${{ secrets.QA_USER_EMAIL }}
      QA_USER_PASSWORD: ${{ secrets.QA_USER_PASSWORD }}
      # BASE_URL_ADMIN / QA_ADMIN_* / seed-API vars: add here if your suite uses them.
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          # PINNED to 24, deliberately NOT `lts/*`. package.json pins @types/node to the 24 line on
          # the stated rule "types = the LTS you actually run in CI" (typing ahead of the runtime
          # types APIs that don't exist yet). `lts/*` FLOATS: Node 26 enters LTS on 2026-10-28, at
          # which point `lts/*` silently becomes 26 while the types stay on 24 — breaking that
          # invariant with no signal. Bump this in LOCKSTEP with package.json's @types/node and
          # engines.node, never on its own.
          node-version: 24
          cache: npm
      - run: npm ci
      # chromium only — matches the scaffold; the active config projects are all Desktop Chrome.
      # Do NOT cache browser binaries (official guidance: restore ≈ download; deps aren't cacheable).
      - run: npx playwright install --with-deps chromium
      - name: Prod-guard (fail-closed — same guard the agents run)
        run: bash scripts/prod-guard.sh
      - name: Run suite (run-of-record — CI fires the json sink; QA_RUN_OF_RECORD for explicitness)
        run: QA_RUN_OF_RECORD=1 npx playwright test
      # Single job → no shard merge needed. If you shard later, use the matrix + merge-reports
      # recipe (CLAUDE.md §Reporting pipeline: blob shards → npx playwright merge-reports).
      - name: Build HTML report from blob
        if: ${{ !cancelled() }}
        run: npx playwright merge-reports --reporter html ./blob-report
      # Action majors are pinned and bumped DELIBERATELY (checkout/setup-node/upload-artifact were
      # all left on v5 while v7 shipped). upload-artifact is the one with a hard expiry — GitHub
      # fully DISABLED v3 in Jan 2025 rather than merely deprecating it, so a stale major here is a
      # nightly that stops uploading traces one day with no warning. Only `name`/`path`/
      # `retention-days` are used below, all stable across these majors.
      # Traces and the HTML report hold CREDENTIALS IN PLAIN TEXT: a Playwright trace records the
      # browser context options (the httpCredentials password, the extraHTTPHeaders values), every
      # fill() value, and the Cookie/Authorization headers. GitHub redacts secrets in logs only,
      # never inside artifacts, and anyone with read access can download an artifact — on a PUBLIC
      # repo that is everyone. Playwright's CI docs: upload reports and traces "only to trusted
      # artifact stores". So the upload runs only on a PRIVATE repo. A `schedule` run has no event
      # payload (github.event.repository is unset), so ask the API. Only an exact `true` counts:
      # on an HTTP error `gh api` prints the error JSON to stdout WITHOUT applying --jq, so a
      # failed lookup must map to `false` (fail closed), never be passed through.
      - name: Repo visibility (gates the artifact upload)
        id: visibility
        if: ${{ !cancelled() }}
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if [ "$(gh api "repos/$GITHUB_REPOSITORY" --jq .private 2>/dev/null)" = true ]; then
            echo "private=true" >> "$GITHUB_OUTPUT"
          else
            echo "private=false" >> "$GITHUB_OUTPUT"
          fi
      - uses: actions/upload-artifact@v7
        if: ${{ !cancelled() && steps.visibility.outputs.private == 'true' }}
        with:
          name: qa-nightly-${{ github.run_number }}
          retention-days: 14
          path: |
            playwright-report/
            artifacts/last-run.json
            artifacts/test-results/**/trace.zip
      - name: Failure breadcrumb
        if: failure()
        run: echo "::error title=qa-nightly red::Nightly run failed — on a private repo download the qa-nightly artifact (trace.zip + last-run.json); on a public repo no artifact is uploaded (traces carry credentials), so re-run the failing spec locally. Then triage with /qa-warden:heal <test-id>."
